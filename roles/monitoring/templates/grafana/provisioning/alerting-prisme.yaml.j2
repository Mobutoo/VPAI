# {{ ansible_managed }}
apiVersion: 1

groups:
  - orgId: 1
    name: "Prisme — SLO"
    folder: "Prisme"
    interval: 1m
    rules:
{# Câblage anticipé (CANARY-4), pour les 2 règles Instagram ci-dessous
   (prisme-instagram-blocked, prisme-instagram-auth-degraded) : producteur
   absent tant que le retour fetcher→prisme (CANARY-5, plan complet dans le
   repo prisme, PAS VPAI : ~/work/saas/prisme/docs/2026-08-03-plan-canary-instagram.md)
   n'existe pas.

   CYCLE 2 (revue precedente, corrige ci-dessous) : le commentaire affirmait
   a tort qu'"instagram_errors_total est a 0 permanent" en attendant
   CANARY-5. C'est FAUX : tant que l'image prisme epinglee (versions.yml:45,
   digest 01b67898, PRE-Instagram) est deployee, ces series METRIQUES SONT
   ABSENTES (aucun point, pas une valeur 0). "absent" et "a 0" ne sont PAS
   equivalents pour Grafana/PromQL : une regle brute sur une serie absente
   part en NoData, pas en 0. D'ou le patron ci-dessous.

   ORDRE DE DEPLOIEMENT OBLIGATOIRE (CANARY-5, a respecter dans cet ordre) :
     1. rebuild + pin de l'image prisme portant les metriques Instagram
        (instagram_connector_state, instagram_errors_total) dans
        inventory/group_vars/all/versions.yml
     2. deploy prisme (le producteur des metriques doit tourner AVANT le
        monitoring, sinon les 2 regles ci-dessous evaluent sur du vide)
     3. deploy monitoring (ce role) -- cf meme sequence documentee en tete de
        roles/prisme-fetcher/defaults/main.yml (section CANARY, gate humain)

   PATRON RETENU (dissout le NoData ET le matching cross-serie) : chaque
   expression finale enveloppe CHAQUE membre de la formule dans
   `(... ) or vector(0)`, de sorte que la serie resultante existe TOUJOURS
   (0 = sain ou absent-donc-neutre, >0 = probleme reel). Consequence assumee
   (limite documentee, pas un bug) : si les metriques Instagram sont
   TOTALEMENT absentes (image pre-Instagram, avant l'etape 1 ci-dessus), les
   deux expressions valent 0 en permanence -- AUCUNE fausse alerte, mais
   AUCUNE detection d'un scrape reellement casse sur ce point de collecte
   precis non plus. Cette limite est couverte par une autre regle du meme
   fichier : prisme-stalled (absent(up{job="prisme"}) ...) detecte la panne
   de scrape au niveau service, pas metrique par metrique -- c'est le filet
   de secours pour ce cas, pas ces 2 regles Instagram elles-memes.

   noDataState reste "Alerting" (defaut du template, cf plus bas) : desormais
   SIGNIFIANT une fois les `or vector(0)` en place, puisque la seule facon
   d'obtenir un NoData ici est une panne totale du pipeline d'evaluation
   Grafana/VictoriaMetrics (pas un etat Instagram normal).

   CORRECTIF 2026-08-04 -- le patron ci-dessus n'avait PAS ete applique a 3
   regles, qui se declenchaient donc PRECISEMENT QUAND TOUT ALLAIT BIEN :
     - prisme-stalled       : `absent(up{...}) or up{...} == 0` est vide a l'etat
                              sain (`absent()` vide si la serie existe, et `== 0`
                              est un FILTRE qui elimine la serie quand up vaut 1).
                              Constate en prod : up=1 et alerte critique Firing.
                              Remplace par `(sum(up{job="prisme"}) or vector(0))`
                              + operator `lt` seuil 1 -- verifie contre VM :
                              job sain = 1, job absent = 0.
     - prisme-karakeep-circuit : serie absente tant que le circuit est ferme.
     - prisme-backup-stale     : `and X > 0` filtre tout tant qu'aucun backup n'a
                              reussi (metrique a 0 en prod le 2026-08-04).
   Regle generale : une expression dont un membre est un FILTRE (`== 0`, `> 0`,
   `absent()`) ne renvoie rien a l'etat sain. Avec noDataState=Alerting, cela
   inverse l'alerte. Toujours terminer par `or vector(0)`.

   NE PAS mettre de commentaire Jinja a l'interieur de la liste de la boucle for
   ci-dessous : le marqueur casse le bloc (cf. commit 05ab9f3). -#}
{% for alert in [
  {
    'uid': 'prisme-stalled',
    'title': 'Prisme unavailable',
    'expr': '(sum(up{job="prisme"}) or vector(0))',
    'threshold': 1,
    'operator': 'lt',
    'severity': 'critical',
    'for': '3m'
  },
  {
    'uid': 'prisme-index-lag',
    'title': 'Prisme Qdrant projection lag',
    'expr': 'qdrant_projection_lag_seconds',
    'threshold': 300,
    'severity': 'critical',
    'for': '5m'
  },
  {
    'uid': 'prisme-projection-drift',
    'title': 'Prisme projection drift',
    'expr': 'increase(prisme_projection_drift_total[15m])',
    'threshold': 0,
    'severity': 'critical',
    'for': '5m',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-queue-stalled',
    'title': 'Prisme outbox queue stalled',
    'expr': 'prisme_queue_depth{queue="outbox"}',
    'threshold': 100,
    'severity': 'warning',
    'for': '10m'
  },
  {
    'uid': 'prisme-budget-low',
    'title': 'Prisme AI budget exhausted',
    'expr': 'prisme_budget_remaining_usd',
    'threshold': 0.01,
    'severity': 'warning',
    'for': '1m',
    'operator': 'lt',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-quality-low',
    'title': 'Prisme retrieval quality regression',
    'expr': 'prisme_retrieval_ndcg',
    'threshold': 0.75,
    'severity': 'warning',
    'for': '15m',
    'operator': 'lt',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-backup-stale',
    'title': 'Prisme backup stale',
    'expr': '((time() - max(prisme_backup_last_success_timestamp_seconds)) and max(prisme_backup_last_success_timestamp_seconds) > 0) or vector(0)',
    'threshold': 93600,
    'severity': 'critical',
    'for': '5m'
  },
  {
    'uid': 'prisme-karakeep-circuit',
    'title': 'Prisme Karakeep circuit open',
    'expr': '(max(karakeep_connector_state{state="circuit_open"}) or vector(0))',
    'threshold': 0,
    'severity': 'warning',
    'for': '5m'
  },
  {
    'uid': 'prisme-instagram-blocked',
    'title': 'Prisme Instagram connector blocked',
    'expr': '(sum(increase(instagram_errors_total{reason="blocked"}[15m])) or vector(0))',
    'threshold': 0,
    'severity': 'warning',
    'for': '5m'
  },
  {
    'uid': 'prisme-instagram-auth-degraded',
    'title': 'Prisme Instagram connector auth degraded while active',
    'expr': '((max(instagram_connector_state{state="active"}) or vector(0)) * (sum(increase(instagram_errors_total{reason="auth"}[15m])) or vector(0)))',
    'threshold': 0,
    'severity': 'critical',
    'for': '5m'
  }
] %}
      - uid: "{{ alert.uid }}"
        title: "{{ alert.title }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: VictoriaMetrics
            model:
              expr: '{{ alert.expr }}'
              intervalMs: 30000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: "{{ alert.operator | default('gt') }}"
                    params: [{{ alert.threshold }}]
        for: "{{ alert['for'] }}"
        # Séries contractuellement toujours présentes → Alerting sur trou (le silence
        # D3 ne doit pas revenir par la porte du NoData) ; séries omittables par design
        # (budget si LiteLLM down, ndcg si eval périmé, drift increase sans donnée) → OK.
        noDataState: "{{ alert.noData | default('Alerting') }}"
        execErrState: Error
        annotations:
          summary: "{{ alert.title }}"
          dashboard_uid: prisme-operations
        labels:
          severity: "{{ alert.severity }}"
          service: prisme
{% endfor %}
