# {{ ansible_managed }}
# Couche 2 — REX 2026-07-27: user-{{ workstation_user_slice_uid }}.slice était
# illimitée (MemoryMax=infinity), y compris les scopes tmux-spawn-*.scope :
# N sessions Claude Code / serveurs MCP pouvaient y saturer toute la RAM sans
# plafond ni sur la taille ni sur le nombre de process. Un throttle
# (MemoryHigh) puis un kill CONTRÔLÉ à l'intérieur de la slice (MemoryMax) est
# infiniment préférable au livelock de reclaim qui a déclenché le hard-reset
# du watchdog matériel. llamaindex-memory-worker (unit systemd --user,
# MemoryMax=4G) vit DANS cette slice — ses 4G restent inclus dans ce budget,
# c'est voulu. Vérifié : un daemon-reload seul suffit à appliquer ces valeurs
# à la slice déjà active, sans la redémarrer (aucun impact sur les sessions
# en cours).
[Slice]
MemoryAccounting=yes
MemoryHigh={{ workstation_user_slice_memory_high }}
MemoryMax={{ workstation_user_slice_memory_max }}
MemorySwapMax={{ workstation_user_slice_memory_swap_max }}
