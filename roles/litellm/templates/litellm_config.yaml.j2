# {{ ansible_managed }}
# LiteLLM proxy configuration — Intelligent routing with tiered models
# Architecture: OpenClaw -> LiteLLM -> (Anthropic, OpenAI, OpenRouter, Google, BytePlus)
# Cache: Redis exact match + Qdrant semantic similarity

model_list:
  # ============================================================
  # TIER PREMIUM — Complex reasoning, architecture, code review
  # ============================================================
  - model_name: "claude-opus"
    litellm_params:
      # Correction gen 4->gen 5 (campagne 3, 2026-08-12, dossier
      # docs/research/2026-08-12-b4-candidats-rangs-hauts.md paragraphes 2/3) :
      # opus-4 ($15/$75) -> opus-5 ($5/$25), gain ~3x. Pinne ZDR
      # (google-vertex -- slug exact re-verifie GET /api/v1/providers le
      # 2026-08-12, PAS "google" comme ecrit au doc source, cf. finding de
      # revue) + allow_fallbacks:false, meme mecanique fail-closed
      # qu'eco-1/eco-2.
      # RESIDU CONNU (non corrige ici, hors perimetre instruit) : la map
      # `fallbacks:` LiteLLM route encore claude-opus -> claude-sonnet ->
      # gpt-codex, aucun des deux n'est pinne ZDR -- une panne du provider
      # google-vertex romprait silencieusement la garantie ZDR pour ce
      # rang. Sans objet pour tenant PII actuellement (OpenClaw profil
      # "premium", pas le chemin factory tenant-data B4.3) ; a trancher
      # si claude-opus devient un jour un chemin tenant-data.
      model: "openrouter/anthropic/claude-opus-5"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 16384
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["google-vertex"]
    model_info:
      max_input_tokens: 1000000
      max_output_tokens: 16384
      input_cost_per_token: 0.000005
      output_cost_per_token: 0.000025
      cache_read_input_token_cost: 0.0000005
      metadata:
        tier: "premium"
        tags: ["code", "architecture", "reasoning", "review-premium", "zdr"]

  - model_name: "claude-sonnet"
    litellm_params:
      # Bascule OpenRouter 2026-08-11 — même raison que claude-opus.
      model: "openrouter/anthropic/claude-sonnet-4"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
    model_info:
      max_input_tokens: 200000
      max_output_tokens: 8192
      metadata:
        tier: "medium"
        tags: ["writing", "analysis", "default", "code"]

  - model_name: "claude-sonnet-cached"
    litellm_params:
      # Alias DÉDIÉ smoke/factory Optimus (2026-08-11) : prompt caching
      # Anthropic injecté côté proxy. SÉPARÉ de "claude-sonnet" car la doc
      # LiteLLM ne liste pas openrouter/ parmi les providers prompt-caching
      # (docs/completion/prompt_caching.md) — propagation du cache_control
      # via OpenRouter à VALIDER EMPIRIQUEMENT (usage.cached_tokens sur 2
      # appels identiques) avant toute généralisation aux alias claude-*.
      # AUCUN fallback pour cet alias : attestation modèle forte voulue.
      model: "openrouter/anthropic/claude-sonnet-4"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
    model_info:
      max_input_tokens: 200000
      max_output_tokens: 8192
      metadata:
        tier: "medium"
        tags: ["code", "optimus-smoke", "prompt-caching"]

  - model_name: "claude-sonnet-5-cached"
    litellm_params:
      # Alias SÉPARÉ, campagne 3 (2026-08-12, docs/research/2026-08-12-b4-
      # candidats-rangs-hauts.md §2). "claude-sonnet-cached" reste INTACT
      # ci-dessus : il est consommé par l'orchestrateur/harnais smoke
      # Optimus (scripts/rotate-smoke-key.sh, scripts/probe-prompt-cache.sh)
      # et changer son modèle sous-jacent est un changement de comportement
      # — variante SÛRE choisie par défaut, migration en place laissée à un
      # geste opérateur explicite (voir plan de deploy, point de décision).
      # Pinné ZDR google-vertex (slug re-vérifié GET /api/v1/providers
      # 2026-08-12) + allow_fallbacks:false, AUCUN fallback niveau routeur,
      # même discipline qu'eco-1/eco-2/claude-sonnet-cached.
      model: "openrouter/anthropic/claude-sonnet-5"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["google-vertex"]
    model_info:
      max_input_tokens: 1000000
      max_output_tokens: 8192
      input_cost_per_token: 0.000002
      output_cost_per_token: 0.00001
      cache_read_input_token_cost: 0.0000002
      metadata:
        tier: "medium"
        tags: ["code", "optimus-smoke", "prompt-caching", "zdr", "campagne3"]

  - model_name: "opus-cached"
    litellm_params:
      # Rang 4 de l'échelle d'escalade B4 (design
      # docs/specs/2026-08-11-b4-design-escalade-modeles-implement.md §7.1,
      # ladder rung "dernier recours"). À CRÉER selon le design — posé ici.
      # Pinné ZDR google-vertex (Bedrock équivalent en prix, non retenu ici
      # pour cohérence avec les autres alias sonnet/opus-5 du même lot) +
      # allow_fallbacks:false, AUCUN fallback niveau routeur.
      model: "openrouter/anthropic/claude-opus-5"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 16384
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["google-vertex"]
    model_info:
      max_input_tokens: 1000000
      max_output_tokens: 16384
      input_cost_per_token: 0.000005
      output_cost_per_token: 0.000025
      cache_read_input_token_cost: 0.0000005
      metadata:
        tier: "premium"
        tags: ["code", "optimus-factory", "escalade-rang4", "prompt-caching", "zdr"]

  - model_name: "claude-haiku"
    litellm_params:
      # Bascule OpenRouter 2026-08-11 — même raison que claude-opus.
      model: "openrouter/anthropic/claude-haiku-4.5"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
    model_info:
      max_input_tokens: 200000
      max_output_tokens: 8192
      metadata:
        tier: "low"
        tags: ["translation", "summary", "quick", "classification"]

  # ============================================================
  # TIER MEDIUM — OpenAI fallbacks and review
  # ============================================================
  - model_name: "gpt-4o"
    litellm_params:
      model: "openai/gpt-4o"
      api_key: "os.environ/OPENAI_API_KEY"
    model_info:
      metadata:
        tier: "medium"
        tags: ["multimodal", "fallback", "analysis"]

  - model_name: "gpt-4o-mini"
    litellm_params:
      model: "openai/gpt-4o-mini"
      api_key: "os.environ/OPENAI_API_KEY"
    model_info:
      metadata:
        tier: "low"
        tags: ["classification", "formatting", "quick"]

  # GPT-5.2 Codex — Code review specialist (placeholder for 5.3 when API public)
  - model_name: "gpt-codex"
    litellm_params:
      model: "openai/codex-mini-latest"
      api_key: "os.environ/OPENAI_API_KEY"
    model_info:
      metadata:
        tier: "medium"
        tags: ["code", "review-smart", "review-premium"]

  # ============================================================
  # TIER ULTRA-LOW — OpenRouter bulk/cheap models
  # ============================================================
{% if openrouter_api_key | default('') | length > 0 %}
