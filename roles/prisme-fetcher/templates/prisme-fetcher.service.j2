# {{ ansible_managed }}
[Unit]
Description=Prisme acquisition worker (local fixture + HTTP/yt-dlp adapters)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User={{ prisme_fetcher_user }}
Group={{ prisme_fetcher_group }}
EnvironmentFile={{ prisme_fetcher_env_file }}
# ProtectHome=true masque /home /root /run/user : sans HOME/XDG_CACHE_HOME
# explicites, yt-dlp (et Python via expanduser) resolvent "~" vers un repertoire
# inaccessible/inexistant du compte de service (create_home: false).
Environment=HOME={{ prisme_fetcher_root }}
Environment=XDG_CACHE_HOME={{ prisme_fetcher_root }}/.cache
ExecStart={{ prisme_fetcher_bin }}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ prisme_fetcher_root }}
# AF_INET/AF_INET6 : requis par les adapters reseau (HTTP + yt-dlp). Si la
# resolution DNS echoue avec un "Address family not supported" au runtime,
# le coupable habituel est la sonde de disponibilite IPv6 de la glibc qui
# passe par AF_NETLINK — non couvert ici par design (pas de socket routing
# necessaire pour de simples requetes sortantes).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
