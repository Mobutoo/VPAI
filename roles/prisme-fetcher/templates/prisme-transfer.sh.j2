#!/usr/bin/env bash
# {{ ansible_managed }}
# Transfert des bundles Prisme (outgoing/) vers banga (prisme-transfer, uid 2101).
# banga est OFFLINE aujourd'hui : desactive par defaut (prisme_transfer_enabled).
# rsync --remove-source-files ne supprime QUE les fichiers effectivement
# transferes avec succes -> un echec partiel/total laisse le backlog local
# intact pour le tick suivant (aucune perte, aucune suppression avant
# confirmation de transfert).
set -euo pipefail

OUTGOING="{{ prisme_fetcher_root }}/outgoing"
TARGET="{{ prisme_transfer_target }}"
SSH_KEY="{{ prisme_transfer_ssh_key }}"
KNOWN_HOSTS="{{ prisme_transfer_known_hosts_file }}"
SSH_PORT="{{ prisme_transfer_ssh_port }}"

if [ ! -s "${KNOWN_HOSTS}" ]; then
  echo "prisme-transfer: known_hosts vide (${KNOWN_HOSTS}) — enrolement banga non fait, on saute ce tick." >&2
  exit 0
fi

# --exclude='.*' : les repertoires ".<sha>.part" sont des bundles en cours de
# construction (rename atomique du repertoire complet une fois le manifeste
# ecrit, cf B1) — jamais synchronises avant leur publication sous leur nom
# final. --timeout borne un transfert bloque (lien tailnet degrade) ;
# ConnectTimeout/ServerAliveInterval bornent l'etablissement/le maintien SSH.
# -rlt (PAS -a) : la racine incoming/ appartient a prisme-store, le compte de
# transfert n'a que le droit de groupe — -a (= -rlptgoD) echoue en code 23 sur
# le chmod/utimes de la racine alors que les fichiers sont bien livres.
# On garde recursion+liens+times fichiers ; perms/owner cote banga = umask +
# setgid du dataset (le janitor/la promotion re-verifient de toute facon).
# Constate au premier drain reel CANARY-5 (2026-08-04).
rsync -rlt --omit-dir-times --partial --timeout=120 --remove-source-files --exclude='.*' \
  -e "ssh -i ${SSH_KEY} -p ${SSH_PORT} -o UserKnownHostsFile=${KNOWN_HOSTS} -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15" \
  "${OUTGOING}/" "${TARGET}"

# Nettoyage des repertoires de bundle vides laisses par --remove-source-files
# (rsync ne supprime jamais de repertoires). Jamais OUTGOING lui-meme, jamais
# les repertoires caches (bundles ".part" en cours de construction ailleurs).
find "${OUTGOING}" -mindepth 1 -type d -not -name '.*' -empty -delete
