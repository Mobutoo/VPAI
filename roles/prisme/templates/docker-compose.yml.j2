# {{ ansible_managed }}
x-prisme-image: &prisme_image "{{ prisme_image_repository }}@{{ prisme_image_digest }}"
x-prisme-env: &prisme_env
  env_file: ["{{ prisme_config_dir }}/prisme.env"]
  restart: unless-stopped
  read_only: true
  security_opt: ["no-new-privileges:true"]
  cap_drop: ["ALL"]
  logging:
    driver: json-file
    options:
      max-size: "{{ docker_log_max_size }}"
      max-file: "{{ docker_log_max_file }}"

services:
  migrate:
    <<: *prisme_env
    restart: "no"
    image: *prisme_image
    command: ["node", "scripts/migrate.mjs"]
    mem_limit: "256M"
    mem_reservation: "128M"
    depends_on:
      db-proxy:
        condition: service_healthy
    networks: [prisme_internal]

  prisme:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "build"]
    mem_limit: "{{ prisme_web_memory_limit }}"
    mem_reservation: "{{ prisme_web_memory_reservation }}"
    expose: ["3000"]
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
    depends_on:
      migrate:
        condition: service_completed_successfully
    networks:
      prisme_internal: {}
      connector_internal: {}
      frontend: {}
      monitoring: {}
      backend:
        ipv4_address: "{{ prisme_service_backend_ip }}"

{% if prisme_workers_enabled | bool %}
  outbox:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: outbox}
    mem_limit: "{{ prisme_outbox_memory_limit }}"
    mem_reservation: "{{ prisme_outbox_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal]

  research-worker:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: research}
    mem_limit: "{{ prisme_research_memory_limit }}"
    mem_reservation: "{{ prisme_research_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal, egress]

  browser:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: browser}
    mem_limit: "{{ prisme_browser_memory_limit }}"
    mem_reservation: "{{ prisme_browser_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal, egress]

  connector:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: connector}
    mem_limit: "{{ prisme_connector_memory_limit }}"
    mem_reservation: "{{ prisme_connector_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal, connector_internal]

  indexer:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: indexer}
    mem_limit: "{{ prisme_indexer_memory_limit }}"
    mem_reservation: "{{ prisme_indexer_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal]

  consolidation:
    <<: *prisme_env
    image: *prisme_image
    command: ["node", "dist-workers/worker.js"]
    environment: {PRISME_WORKER_KIND: consolidation}
    mem_limit: "{{ prisme_consolidation_memory_limit }}"
    mem_reservation: "{{ prisme_consolidation_memory_reservation }}"
    depends_on: {migrate: {condition: service_completed_successfully}}
    networks: [prisme_internal]

  sparse-query:
    image: "{{ prisme_knowledge_embedding_image }}"
    restart: unless-stopped
    read_only: true
    user: "2102:2100"
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    environment:
      PRISME_EMBEDDING_TOKEN: "{{ vault_prisme_embedding_token }}"
      PRISME_EMBEDDING_MODE: sparse-query-only
      PRISME_EMBEDDING_DEVICE: cpu
      PRISME_EMBEDDING_CACHE_CAPACITY: "4096"
      PRISME_SPARSE_THREADS: "2"
      HF_HOME: /models
      HF_HUB_OFFLINE: "1"
      TRANSFORMERS_OFFLINE: "1"
    expose: ["8080"]
    volumes: ["{{ prisme_model_dir }}:/models:ro"]
    tmpfs: ["/tmp:rw,noexec,nosuid,nodev,size=256m"]
    pids_limit: 256
    mem_limit: "{{ prisme_sparse_memory_limit }}"
    mem_reservation: "{{ prisme_sparse_memory_reservation }}"
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/ready', timeout=3)",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
    networks: [prisme_internal]
{% endif %}

  db-proxy:
    image: "{{ prisme_db_proxy_image }}"
    restart: unless-stopped
    read_only: true
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    logging:
      driver: json-file
      options:
        max-size: "{{ docker_log_max_size }}"
        max-file: "{{ docker_log_max_file }}"
    healthcheck:
      test: ["CMD", "haproxy", "-c", "-f", "/usr/local/etc/haproxy/haproxy.cfg"]
      interval: 30s
      timeout: 5s
      retries: 3
    mem_limit: "{{ prisme_db_proxy_memory_limit }}"
    mem_reservation: "{{ prisme_db_proxy_memory_reservation }}"
    volumes:
      - "{{ prisme_config_dir }}/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro"
    networks:
      prisme_internal:
        ipv4_address: "{{ prisme_db_proxy_internal_ip }}"
      backend:
        ipv4_address: "{{ prisme_db_proxy_backend_ip }}"

networks:
  prisme_internal:
    internal: true
    ipam:
      config: [{subnet: "{{ prisme_internal_subnet }}"}]
  connector_internal:
    external: true
    name: "{{ prisme_connector_network }}"
  frontend:
    external: true
    name: "{{ prisme_frontend_network }}"
  backend:
    external: true
    name: "{{ prisme_backend_network }}"
  egress:
    external: true
    name: "{{ prisme_egress_network }}"
  monitoring:
    external: true
    name: "{{ prisme_monitoring_network }}"
