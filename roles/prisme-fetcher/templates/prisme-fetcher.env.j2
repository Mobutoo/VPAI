# {{ ansible_managed }}
# Fichier lu par systemd (EnvironmentFile) AVANT que le service ne bascule sur
# {{ prisme_fetcher_user }} -> mode 0600 root:root est correct meme si le
# worker tourne sous un compte de service dedie.
#
# Jeton d'authentification vers le control-plane Prisme. Pas encore consomme
# par un appel reseau du worker (aucun heartbeat/etat distant implemente a ce
# jour) : cable ici par anticipation pour eviter un futur redeploy juste pour
# injecter le secret. Cf tasks/main.yml (assert vault_prisme_fetcher_token).
PRISME_FETCHER_TOKEN={{ vault_prisme_fetcher_token }}
