}
_INSTAGRAM_HANDLE_RE = re.compile(r"^[A-Za-z0-9_.]{1,30}$")
_INSTAGRAM_RANGE_RE = re.compile(r"^\d+-\d+$")

REDIRECT_CODES = (301, 302, 303, 307, 308)

_SIZE_UNITS = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
_SIZE_RE = re.compile(r"(\d+(?:\.\d+)?)([KMGT]?)B?", re.IGNORECASE)
_UNSAFE_FILENAME_CHARS = re.compile(r"[^A-Za-z0-9._-]")


class InstagramBlocked(RuntimeError):
    """Instagram a repondu challenge/2FA/rate-limit/auth — terminal, AUCUN retry."""


def parse_size(value: str) -> int:
    match = _SIZE_RE.fullmatch(value.strip())
    if not match:
        raise ValueError(f"invalid_size:{value}")
    number, unit = match.groups()
    return int(float(number) * _SIZE_UNITS[unit.upper()])


def sanitize_filename(name: str, fallback: str) -> str:
    # A6/A1 : neutralise toute tentative de traversee de chemin ou d'ecrasement
    # du manifeste via un nom de fichier hostile venant d'un serveur distant
    # (Content-Disposition/URL path pour http, nom yt-dlp pour ytdlp). Le nom
    # final doit rester strictement dans le repertoire de destination et ne
    # jamais pouvoir collisionner avec manifest.json.
    cleaned = _UNSAFE_FILENAME_CHARS.sub("_", name)
    if not cleaned or cleaned in (".", "..") or cleaned.startswith(".") or cleaned.lower() == "manifest.json":
        return fallback
    return cleaned


def dir_size(path: Path) -> int:
    # R2 (revue 2026-08-03, cycle 3) : rglob()/stat() peuvent lever OSError si
    # une entree disparait entre l'iteration et le stat() (race benigne —
    # fichier supprime/deplace concurremment, ex. gallery-dl qui finalise un
    # media pendant qu'on mesure). Fonction PARTAGEE entre fetch_ytdlp et
    # fetch_instagram : ce fix beneficie aux deux adapters, jamais un
    # elargissement de comportement propre a l'un ou l'autre.
    total = 0
    try:
        for entry in path.rglob("*"):
            try:
                if entry.is_file():
                    total += entry.stat().st_size
            except OSError:
                continue
    except OSError:
        pass
    return total


class AllowlistViolation(RuntimeError):
    """Raised when a URL (or one of its redirect hops) is not allowlisted."""


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):  # noqa: ANN001
        return None


_OPENER = urllib.request.build_opener(_NoRedirect)


def stop(_signum: int, _frame: object) -> None:
    global STOP
    STOP = True


def acquire_singleton_lock() -> None:
    # M1 : fcntl.flock exclusif non bloquant sur ROOT/.worker.lock — un seul
    # writer SQLite reel a la fois pour cette instance de ROOT (le
    # commentaire de l'unite systemd affirmait cette garantie sans jamais
    # l'appliquer ; verify.yml lance lui-meme un --once qui doit pouvoir
    # coexister sequentiellement avec le service, jamais en concurrence).
    global _LOCK_HANDLE
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    # M-E (revue 2026-08-03, cycle 2) : l'ouverture elle-meme peut echouer
    # (permissions, ROOT non accessible au compte de service) — auparavant
    # non rattrapee, un PermissionError se propageait en traceback brut
    # (crash-loop bruyant sous systemd Restart=on-failure). Meme discipline
    # fail-loud-mais-propre que le flock ci-dessous : message explicite,
    # sys.exit(1), jamais de traceback.
    try:
        handle = open(LOCK_FILE, "a+")  # noqa: SIM115 (garde le fd ouvert pour la duree du process)
    except OSError as error:
        print(json.dumps({
            "event": "worker_lock_open_failed",
            "lock_file": str(LOCK_FILE),
            "error": str(error),
        }))
        sys.exit(1)
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        print(json.dumps({"event": "worker_already_running", "lock_file": str(LOCK_FILE)}))
        sys.exit(1)
    _LOCK_HANDLE = handle


def connect() -> sqlite3.Connection:
    db = sqlite3.connect(DATABASE)
    db.row_factory = sqlite3.Row
    db.execute("pragma journal_mode=wal")
    # M1 : busy_timeout complementaire au flock applicatif ci-dessus (defense
    # en profondeur si un outil externe ouvre la base directement, ex.
    # inspection manuelle service arrete).
    db.execute("pragma busy_timeout=5000")
    db.execute("""create table if not exists items (
        source_path text primary key,
        sha256 text not null,
        state text not null,
        output_path text,
        updated_at integer not null
    )""")
    db.execute("""create table if not exists heartbeat (
        singleton integer primary key check(singleton=1),
        updated_at integer not null
    )""")
    db.execute("""create table if not exists jobs (
        job_id text primary key,
        url text not null,
        adapter text not null,
        note text,
        state text not null,
        attempts integer not null default 0,
        next_attempt_at integer not null default 0,
        domain text,
        manifest_path text,
        output_path text,
        error text,
        created_at integer not null,
        updated_at integer not null
    )""")
    db.execute("""create table if not exists domain_state (
        domain text primary key,
        last_fetch_at integer not null
    )""")
    return db


# --- Mode fixture (inchange) : depot local incoming/*.ready -> outgoing/<sha256>/ ---


def process_fixture(db: sqlite3.Connection, source: Path) -> None:
    if shutil.disk_usage(ROOT).free < MIN_FREE_BYTES:
        raise RuntimeError("disk_low")
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    previous = db.execute(
        "select state, sha256 from items where source_path=?", (str(source),)
    ).fetchone()
    if previous is not None and previous["state"] == "transferred_ready" and previous["sha256"] == digest:
        return
    # B1 : meme discipline d'atomicite que process_job — le bundle complet
    # (media + manifest) est construit sous un repertoire cache puis publie
    # par un seul rename() de repertoire.
    bundle = OUTGOING / digest
    if not bundle.exists():
        bundle_part = OUTGOING / f".{digest}.part"
        shutil.rmtree(bundle_part, ignore_errors=True)
        bundle_part.mkdir(mode=0o750, exist_ok=True)
        target = bundle_part / source.name.removesuffix(".ready")
        with source.open("rb") as reader, target.open("wb") as writer:
            shutil.copyfileobj(reader, writer)
            writer.flush()
            os.fsync(writer.fileno())
        manifest = {
            "schema": "prisme.source-bundle.v1",
            "adapter": "local-upload-fixture",
            "sha256": digest,
            "filename": target.name,
        }
        (bundle_part / "manifest.json").write_text(json.dumps(manifest, sort_keys=True) + "\n")
        bundle_part.replace(bundle)
    db.execute(
        """insert into items(source_path,sha256,state,output_path,updated_at)
        values(?,?,?,?,?) on conflict(source_path) do update set
        sha256=excluded.sha256,state=excluded.state,
        output_path=excluded.output_path,updated_at=excluded.updated_at""",
        (str(source), digest, "transferred_ready", str(bundle), int(time.time())),
    )
    db.commit()


# --- Mode job reseau : jobs/*.json -> manifest AVANT telechargement -> outgoing/<sha256>/ ---


def domain_allowed(host: str) -> bool:
    if not host:
        return False
    host = host.lower()
    for pattern in ALLOWED_DOMAINS:
        # L-D (revue 2026-08-03, cycle 2) : l'assert Ansible (tasks/main.yml,
        # H3/M-D) normalise chaque motif avec `| trim | lower` avant
        # comparaison ; ce worker ne faisait que `.lower()` (jamais de trim)
        # -> un motif avec espace parasite ("  .instagram.com") pouvait passer
        # l'assert fail-loud (trim cote controle) tout en matchant
        # DIFFEREMMENT ici au runtime (sans trim). Direction du bug jugee sure
        # (l'assert etait plus strict, jamais l'inverse) mais faux positif
        # fail-loud possible ; aligner les deux cote sur `trim + lower`.
        pattern = pattern.strip().lower()
        if pattern.startswith("."):
            if host == pattern[1:] or host.endswith(pattern):
                return True
        elif host == pattern:
            return True
    return False


def content_type_allowed(content_type: str) -> bool:
    if not content_type:
        return False
    for pattern in HTTP_ALLOWED_CONTENT_TYPES:
        if pattern.endswith("/"):
            if content_type.startswith(pattern):
                return True
        elif content_type == pattern:
            return True
    return False


def write_manifest(workdir: Path, manifest: dict) -> Path:
    part = workdir / ".manifest.json.part"
    part.write_text(json.dumps(manifest, sort_keys=True) + "\n")
    final = workdir / "manifest.json"
    part.replace(final)
    return final


def update_job(db: sqlite3.Connection, job_id: str, **fields: object) -> None:
    fields.setdefault("updated_at", int(time.time()))
    columns = ", ".join(f"{key}=:{key}" for key in fields)
    fields["job_id"] = job_id
    db.execute(f"update jobs set {columns} where job_id=:job_id", fields)  # noqa: S608
    db.commit()


def rate_limited(db: sqlite3.Connection, domain: str, now: int, limit_seconds: int = RATE_LIMIT_SECONDS) -> bool:
    row = db.execute(
        "select last_fetch_at from domain_state where domain=?", (domain,)
    ).fetchone()
    return bool(row) and (now - row["last_fetch_at"]) < limit_seconds


def mark_domain_fetch(db: sqlite3.Connection, domain: str) -> None:
    # L-C (revue 2026-08-03, cycle 2) : horodatage pris ICI, au moment REEL du
    # marquage — jamais le `now` calcule au debut de la passe scan_jobs et
    # transmis en argument. Un job long (Instagram, jusqu'a
    # INSTAGRAM_MAX_JOB_SECONDS) dont le marquage utiliserait le `now` de
    # debut de passe neutraliserait le rate-limit inter-jobs : le prochain job
    # sur le meme domaine verrait un ecart artificiellement agrandi de la
    # duree du job precedent.
    if not domain:
        return
    db.execute(
        """insert into domain_state(domain,last_fetch_at) values(?,?)
        on conflict(domain) do update set last_fetch_at=excluded.last_fetch_at""",
        (domain, int(time.time())),
    )
    db.commit()


def touch_heartbeat(db: sqlite3.Connection) -> None:
    db.execute(
        """insert into heartbeat(singleton,updated_at) values(1,?)
        on conflict(singleton) do update set updated_at=excluded.updated_at""",
        (int(time.time()),),
    )
    db.commit()


def load_job(path: Path) -> dict | None:
    try:
        payload = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    url = payload.get("url")
    adapter = payload.get("adapter")
    if not isinstance(url, str) or adapter not in ("http", "ytdlp", "instagram"):
        return None
    # A8 : le scheme est verifie ici pour TOUS les adapters (http, ytdlp,
    # instagram). yt-dlp accepte des schemes non-http (fichiers locaux via
    # extracteur generique, IE) que ce worker ne doit jamais soumettre sans
    # revalidation.
    if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
        return None
    job = {"url": url, "adapter": adapter, "note": payload.get("note")}
    if adapter == "instagram":
        handle = payload.get("handle")
        if not isinstance(handle, str) or not handle:
            return None
        job["handle"] = handle
        job_range = payload.get("range")
        if job_range is not None and not isinstance(job_range, str):
            return None
        job["range"] = job_range
    return job


def instagram_handle_from_url(url: str) -> str | None:
    # /p/<shortcode>/, /reel/<shortcode>/, etc. ne portent AUCUN handle : seul
    # le champ "handle" du job fait foi dans ce cas (piege — un handle derive
    # a tort de ces segments serait un contournement d'allowlist).
    path = urllib.parse.urlsplit(url).path.strip("/")
    if not path:
        return None
    segments = path.split("/")
    first = segments[0].lower()
    if first == "stories":
        # H4 (revue 2026-08-03) : stories/<handle>/<story_id>/ (et
        # stories/highlights/<id>/, fail-closed par design — "highlights" est
        # un segment qui ne correspond a aucun handle autorise) porte le
        # handle/victime en 2e segment, jamais en 1er. Sans ce cas special,
        # le mismatch stories/<victime>/... n'etait jamais compare (piege
        # exploitable — le job "handle" auto-declare aurait seul fait foi).
        return segments[1].lower() if len(segments) > 1 and segments[1] else None
    if first in _INSTAGRAM_NON_PROFILE_SEGMENTS:
        return None
    return first


def instagram_job_allowed(job: dict, domain: str) -> tuple[bool, str]:
    if not INSTAGRAM_ENABLED:
        return False, "instagram_adapter_disabled"
    if domain not in INSTAGRAM_DOMAINS:
        return False, "domain_not_allowlisted"
    handle = job.get("handle") or ""
    if not _INSTAGRAM_HANDLE_RE.fullmatch(handle):
        return False, "handle_missing_or_invalid"
    if handle.lower() not in {h.lower() for h in INSTAGRAM_ALLOWED_HANDLES}:
        return False, "handle_not_allowlisted"
    url_handle = instagram_handle_from_url(job["url"])
    if url_handle is not None and url_handle != handle.lower():
        return False, "handle_mismatch"
    return True, ""


def instagram_cookies_path() -> Path:
    # LoadCredential (unite systemd) copie le secret dans un repertoire prive
    # expose via $CREDENTIALS_DIRECTORY — jamais l'InaccessiblePaths generique
    # de l'unite, jamais argv, jamais journalise.
    directory = os.environ.get("CREDENTIALS_DIRECTORY")
    if not directory:
        raise RuntimeError("instagram_cookies_unavailable")
    path = Path(directory) / INSTAGRAM_CREDENTIAL_NAME
    if not path.is_file():
        raise RuntimeError("instagram_cookies_unavailable")
    return path


_INSTAGRAM_NUMERIC_MARKER_RE_CACHE: dict[str, re.Pattern[str]] = {}


def classify_instagram_failure(stderr_tail: str) -> str | None:
    # M5 (revue 2026-08-03) : un marqueur PUREMENT numerique ("401"/"403"/
    # "429") matchait auparavant en simple sous-chaine — un shortcode hostile
    # type "C403xyz" declenchait a tort un blocage terminal sur un echec
    # transitoire. Ancre sur une frontiere de mot (\b) pour ces marqueurs
    # UNIQUEMENT ; les marqueurs textuels restent en sous-chaine (deja assez
    # longs pour ne jamais produire de faux positif).
    lowered = stderr_tail.lower()
    for marker, reason in INSTAGRAM_BLOCKED_MARKERS.items():
        marker_lower = marker.lower()
        if marker_lower.isdigit():
            pattern = _INSTAGRAM_NUMERIC_MARKER_RE_CACHE.get(marker_lower)
            if pattern is None:
                pattern = re.compile(r"\b" + re.escape(marker_lower) + r"\b")
                _INSTAGRAM_NUMERIC_MARKER_RE_CACHE[marker_lower] = pattern
            if pattern.search(lowered):
                return reason
        elif marker_lower in lowered:
            return reason
    return None


def fetch_http(url: str, workdir: Path) -> tuple[str, str, str]:
    current = url
    for _hop in range(HTTP_MAX_REDIRECTS + 1):
        parsed = urllib.parse.urlsplit(current)
        if parsed.scheme not in ("http", "https"):
            raise AllowlistViolation("unsupported_scheme")
        host = (parsed.hostname or "").lower()
        if not domain_allowed(host):
            raise AllowlistViolation("redirect_left_allowlist")
        request = urllib.request.Request(current, headers={"User-Agent": HTTP_USER_AGENT})
        try:
            response = _OPENER.open(request, timeout=HTTP_TIMEOUT_SECONDS)
        except urllib.error.HTTPError as error:
            if error.code in REDIRECT_CODES:
                location = error.headers.get("Location")
                error.close()
                if not location:
                    raise RuntimeError("redirect_without_location") from error
                current = urllib.parse.urljoin(current, location)
                continue
            error.close()
            raise
        with response:
            if response.status in REDIRECT_CODES:
                location = response.headers.get("Location")
                if not location:
                    raise RuntimeError("redirect_without_location")
                current = urllib.parse.urljoin(current, location)
                continue
            content_type = (response.headers.get("Content-Type") or "").split(";")[0].strip().lower()
            if not content_type_allowed(content_type):
                raise RuntimeError(f"content_type_rejected:{content_type or 'unknown'}")
            digest_ctx = hashlib.sha256()
            tmp = workdir / ".download.part"
            total = 0
            with tmp.open("wb") as writer:
                while True:
                    if STOP:
                        writer.close()
                        tmp.unlink(missing_ok=True)
                        raise RuntimeError("worker_stopping")
                    chunk = response.read(65536)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > HTTP_MAX_BYTES:
                        writer.close()
                        tmp.unlink(missing_ok=True)
                        raise RuntimeError("max_bytes_exceeded")
                    writer.write(chunk)
                    digest_ctx.update(chunk)
                writer.flush()
                os.fsync(writer.fileno())
            digest = digest_ctx.hexdigest()
            # A6 : le nom de fichier distant (path URL / Content-Disposition non
            # consulte ici par choix) est assaini avant tout usage disque —
            # jamais de traversee de chemin ni de collision avec manifest.json.
            filename = sanitize_filename(Path(parsed.path).name or digest, digest)
            target = workdir / filename
            tmp.replace(target)
            return digest, filename, content_type
    raise RuntimeError("too_many_redirects")


def fetch_ytdlp(url: str, workdir: Path) -> tuple[str, str]:
    # Limitation connue et assumee : l'allowlist ne couvre que l'URL d'entree
    # soumise au job. yt-dlp resout ensuite des CDN media arbitraires en
    # interne (non re-verifies) -> jamais presente comme une garantie
    # bout-en-bout dans le manifest (cf champ allowlist_scope).
    output_template = str(workdir / "%(id)s.%(ext)s")
    env = dict(os.environ)
    env["HOME"] = str(ROOT)
    env["XDG_CACHE_HOME"] = str(CACHE)
    # A11 : jamais de config utilisateur/systeme implicite pour un binaire qui
    # tourne avec des privileges reseau sortants.
    env["XDG_CONFIG_HOME"] = str(CACHE)
    command = [
        "yt-dlp",
        "--ignore-config",
        "--no-playlist",
        "--max-filesize", YTDLP_MAX_FILESIZE,
        "--no-continue",
        "--format", YTDLP_FORMAT,
        "--user-agent", HTTP_USER_AGENT,
        "--no-progress",
        "--restrict-filenames",
        "-o", output_template,
        "--",
        url,
    ]
    # A4 : --max-filesize ne couvre pas les manifestes HLS/DASH (segments non
    # annonces a l'avance) ni le remux ffmpeg final (copie temporaire du
    # fichier deja telecharge -> jusqu'a x2-x3 pendant la fusion). On borne
    # donc durement en surveillant la taille reelle du repertoire de travail
    # et on tue le process au-dela d'une marge de securite x3.
    hard_cap = parse_size(YTDLP_MAX_FILESIZE) * 3
    existing = {p.name for p in workdir.iterdir()}
    stdout_path = workdir / ".ytdlp.stdout"
    stderr_path = workdir / ".ytdlp.stderr"
    deadline = time.monotonic() + HTTP_TIMEOUT_SECONDS * 20
    killed_reason = None
    with stdout_path.open("wb") as out, stderr_path.open("wb") as err:
        proc = subprocess.Popen(command, cwd=workdir, env=env, stdout=out, stderr=err)  # noqa: S603
        while True:
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass
            else:
                break
            if STOP:
                killed_reason = "worker_stopping"
            elif dir_size(workdir) > hard_cap:
                killed_reason = "ytdlp_size_cap_exceeded"
            elif time.monotonic() > deadline:
                killed_reason = "ytdlp_timeout"
            if killed_reason:
                proc.terminate()
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=10)
                break
    if killed_reason:
        raise RuntimeError(killed_reason)
    if proc.returncode != 0:
        stderr_tail = stderr_path.read_bytes()[-500:].decode("utf-8", "replace")
        raise RuntimeError(f"ytdlp_failed:{proc.returncode}:{stderr_tail}")
    # A1 : delta AVANT/APRES l'appel adapter (jamais un tri global sur
    # workdir qui pourrait re-selectionner un fichier de log/etat au lieu du
    # media reel). Les *.part residuels sont rejetes explicitement.
    produced = sorted(
        p for p in workdir.iterdir()
        if p.is_file()
        and p.name not in existing
        and not p.name.startswith(".")
        and not p.name.endswith(".part")
    )
    if len(produced) != 1:
        raise RuntimeError(f"ytdlp_ambiguous_output:{len(produced)}")
    source = produced[0]
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    filename = sanitize_filename(source.name, digest)
    if filename != source.name:
        renamed = workdir / filename
        source.replace(renamed)
        source = renamed
    return digest, filename


def fetch_instagram(
    db: sqlite3.Connection, url: str, workdir: Path, job_range: str, archive_path: Path, range_upper: int
) -> list[dict]:
    cookies_path = instagram_cookies_path()
    env = dict(os.environ)
    env["HOME"] = str(ROOT)
    env["XDG_CACHE_HOME"] = str(CACHE)
    # A11 (meme doctrine que yt-dlp) : jamais de config utilisateur/systeme
    # implicite pour un binaire qui tourne avec des privileges reseau sortants
    # ET des cookies de session sensibles.
    env["XDG_CONFIG_HOME"] = str(CACHE)
    command = [
        INSTAGRAM_GALLERY_DL_BIN,
        "--config-ignore",
        "-C", str(cookies_path),
        "--range", job_range,
        # H5/H6 (revue 2026-08-03) : archive SCOPEE PAR JOB (workdir), jamais
        # directement l'archive persistante partagee. process_instagram_job
        # seed cette copie depuis l'archive persistante (dedup cross-job,
        # H6) avant l'appel ; la fusion vers l'archive persistante ne se
        # produit qu'APRES livraison reussie (merge_instagram_archive), donc
        # un crash entre acquisition et livraison ne pollue jamais l'archive
        # partagee (H5 — sans ca, un retry apres crash voyait
        # files_info==[] et le job etait a tort marque done/skip, perte
        # definitive et silencieuse).
        "--download-archive", str(archive_path),
        # Sleep natif gallery-dl (en plus du rate-limit par compte+domaine
        # applique cote worker AVANT meme de lancer ce process — cf
        # process_instagram_job/scan_jobs) : jamais de contournement du
        # rythme conservateur, meme au sein d'un seul job multi-media.
        "--sleep-request", str(INSTAGRAM_RATE_LIMIT_SECONDS),
        "--http-timeout", str(INSTAGRAM_HTTP_TIMEOUT_SECONDS),
        "--write-metadata",
        "-D", str(workdir),
        "--",
        url,
    ]
    existing = {p.name for p in workdir.iterdir()}
    stdout_path = workdir / ".gallery-dl.stdout"
    stderr_path = workdir / ".gallery-dl.stderr"
    # H7 (revue 2026-08-03) : deadline derivee de la borne haute REELLE de
    # --range (jamais une constante fixe — --sleep-request s'applique ENTRE
    # CHAQUE media de la plage ; range_upper * (rate_limit+http_timeout) *
    # marge couvre le sommeil natif gallery-dl cumule + les requetes elles-
    # memes, avec une marge de securite documentee dans defaults/main.yml).
    # H-C (revue 2026-08-03, cycle 2) : plafond dur en defense en profondeur —
    # range_upper est deja borne par INSTAGRAM_RANGE_MAX_UPPER avant l'appel
    # (process_instagram_job), donc ce min() ne devrait jamais rogner la
    # formule H7 en usage normal, mais aucune fonction adapter reseau ne doit
    # pouvoir depasser ce plafond meme si un appelant futur oubliait la
    # validation en amont.
    deadline = time.monotonic() + min(
        range_upper * (INSTAGRAM_RATE_LIMIT_SECONDS + INSTAGRAM_HTTP_TIMEOUT_SECONDS) * INSTAGRAM_DEADLINE_MARGIN,
        INSTAGRAM_MAX_JOB_SECONDS,
    )
    killed_reason = None
    with stdout_path.open("wb") as out, stderr_path.open("wb") as err:
        proc = subprocess.Popen(command, cwd=workdir, env=env, stdout=out, stderr=err)  # noqa: S603
        # R2 (revue 2026-08-03, cycle 3) : try/finally sur TOUTE la boucle —
        # avant ce fix, une exception NON prevue levee dans la boucle (dont le
        # heartbeat lui-meme, cf touch_heartbeat ci-dessous, OperationalError
        # sqlite3 atteignable en pratique) sortait du bloc `with Popen` SANS
        # jamais appeler terminate()/kill() : gallery-dl continuait de tourner
        # ORPHELIN, hors deadline/plafond taille/cgroup, pendant que le
        # process appelant repartait en erreur et purgeait potentiellement
        # workdir (rmtree) sous les file descriptors du process encore
        # ouverts. Idempotent (proc.poll() is None) : si le process est deja
        # termine (sortie normale de boucle ou deja tue par le bloc
        # killed_reason ci-dessous), ce bloc est un no-op.
        try:
            while True:
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    pass
                else:
                    break
                # H-C : un job Instagram peut legitimement occuper le worker
                # singleton (M1) pendant plusieurs minutes — sans ce heartbeat
                # dans la boucle d'attente elle-meme, un watchdog externe
                # lirait une heartbeat perimee pendant toute la duree du job
                # et pourrait a tort le declarer mort.
                try:
                    touch_heartbeat(db)
                except sqlite3.Error as error:
                    # R2 : une ecriture heartbeat manquee ne doit JAMAIS faire
                    # sortir cette boucle (le try/finally ci-dessous couvrirait
                    # le kill, mais mieux vaut ne pas interrompre un job en
                    # cours pour un seul heartbeat rate) — logge et continue,
                    # jamais un silence total (BLE001 volontaire, sqlite3.Error
                    # couvre OperationalError/lock etc.).
                    print(json.dumps({
                        "event": "heartbeat_write_failed",
                        "error": str(error),
                    }))
                if STOP:
                    killed_reason = "worker_stopping"
                elif dir_size(workdir) > INSTAGRAM_MAX_BUNDLE_BYTES:
                    killed_reason = "instagram_size_cap_exceeded"
                elif time.monotonic() > deadline:
                    killed_reason = "instagram_timeout"
                if killed_reason:
                    proc.terminate()
                    try:
                        proc.wait(timeout=10)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                        proc.wait(timeout=10)
                    break
        finally:
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=10)
    if killed_reason:
        raise RuntimeError(killed_reason)
    if proc.returncode != 0:
        stderr_tail = stderr_path.read_bytes()[-500:].decode("utf-8", "replace")
        blocked_reason = classify_instagram_failure(stderr_tail)
        if blocked_reason:
            # Arret propre sur challenge/2FA/rate-limit/auth : AUCUN retry
            # automatique, jamais de contournement CAPTCHA/challenge (design).
            raise InstagramBlocked(blocked_reason)
        raise RuntimeError(f"instagram_failed:{proc.returncode}")
    # Delta AVANT/APRES (meme discipline A1 que fetch_ytdlp). --download-archive
    # peut legitimement ne produire AUCUN fichier (post deja acquis) : ce n'est
    # PAS une erreur, l'appelant traite une liste vide comme un succes
    # idempotent (skip_already_acquired), jamais un ambiguous_output/retry.
    produced = sorted(
        p for p in workdir.iterdir()
        if p.is_file()
        and p.name not in existing
        and not p.name.startswith(".")
        and not p.name.endswith(".part")
    )
    media_files = [p for p in produced if p.suffix.lower() != ".json"]
    files_info: list[dict] = []
    seen_filenames: set[str] = set()
    # M6 (revue 2026-08-03) : noms ORIGINAUX pas encore traites — un media
    # dont le nom assaini collisionnerait avec le nom original d'un media
    # PAS ENCORE parcouru serait ecrase par media.replace() avant meme
    # d'etre lu/hashe (perte silencieuse d'un media du carrousel). Initialise
    # avec tous les noms restants ; chaque media traite retire son propre nom.
    pending_names = {p.name for p in media_files}
    for media in media_files:
        pending_names.discard(media.name)
        # L1 (revue 2026-08-03) : le sidecar --write-metadata est resolu
        # depuis le nom ORIGINAL du media, AVANT tout renommage
        # d'assainissement. Le resoudre APRES (comme avant ce fix) cherchait
        # <nom_assaini>.json qui n'existe jamais quand le nom a change —
        # metadata perdue -> neutralisait entierement l'enforcement H4
        # (username absent == rejet, mais pour la mauvaise raison).
        original_sidecar = media.with_name(media.name + ".json")
        metadata: dict = {}
        if original_sidecar.exists():
            try:
                raw_meta = json.loads(original_sidecar.read_text())
                metadata = {
                    key: raw_meta[key]
                    for key in ("id", "date", "description", "username", "shortcode")
                    if key in raw_meta
                }
                if "username" not in metadata:
                    # M-G (revue 2026-08-03, cycle 2) : la cle racine
                    # "username" n'est pas garantie par toutes les versions/
                    # extracteurs gallery-dl — repli sur owner.username (objet
                    # imbrique) puis owner_username (cle aplatie), les deux
                    # formes observees selon l'extracteur. Fixture reelle a
                    # figer en CANARY-5 (indice revue : gallery-dl expose
                    # potentiellement post_shortcode, pas shortcode — a
                    # reverifier contre un export reel avant CANARY-5).
                    fallback_username = None
                    owner = raw_meta.get("owner")
                    if isinstance(owner, dict):
                        fallback_username = owner.get("username")
                    if not fallback_username:
                        fallback_username = raw_meta.get("owner_username")
                    if fallback_username:
                        metadata["username"] = fallback_username
            except (OSError, json.JSONDecodeError):
                metadata = {}
            # --write-metadata cree <fichier_media_complet>.json (suffixe
            # ajoute, jamais un remplacement d'extension) : bundle enrichi
            # puis supprime, jamais livre tel quel (evite de dupliquer/leaker
            # des champs bruts gallery-dl non selectionnes).
            original_sidecar.unlink(missing_ok=True)
        digest = hashlib.sha256(media.read_bytes()).hexdigest()
        filename = sanitize_filename(media.name, digest)
        collides = (
            filename in seen_filenames
            or filename in pending_names
            or (filename != media.name and (workdir / filename).exists())
        )
        if collides:
            # Collision post-assainissement entre deux medias distincts du
            # meme carrousel (ou avec un media pas encore traite) :
            # desambiguise plutot que d'ecraser silencieusement.
            filename = f"{digest[:16]}_{filename}"
        seen_filenames.add(filename)
        target = media if filename == media.name else workdir / filename
        if target != media:
            media.replace(target)
        files_info.append({"filename": filename, "sha256": digest, "metadata": metadata})
    return files_info


def merge_instagram_archive(job_archive: Path, persistent_archive: Path) -> None:
    # H5/H6 : fusionne les entrees acquises par CE job (archive scopee,
    # workdir) vers l'archive persistante partagee — appele UNIQUEMENT apres
    # une livraison reussie (deliver_instagram_bundle). Generique sur le
    # schema (tables lues depuis sqlite_master de la source, jamais un nom de
    # table code en dur -> resilient a une evolution du schema gallery-dl).
    if not job_archive.exists():
        return
    persistent_archive.parent.mkdir(parents=True, exist_ok=True)
    src = sqlite3.connect(job_archive)
    try:
        tables = [
            row[0]
            for row in src.execute("select name from sqlite_master where type='table'")
        ]
        dst = sqlite3.connect(persistent_archive)
        try:
            dst.execute("pragma busy_timeout=5000")
            for table in tables:
                schema_row = src.execute(
                    "select sql from sqlite_master where type='table' and name=?", (table,)
                ).fetchone()
                if schema_row and schema_row[0]:
                    dst.execute(schema_row[0].replace("CREATE TABLE", "CREATE TABLE IF NOT EXISTS", 1))
                rows = src.execute(f"select * from {table}").fetchall()  # noqa: S608 (table name from sqlite_master, not external input)
                if rows:
                    placeholders = ",".join("?" * len(rows[0]))
                    dst.executemany(
                        f"insert or ignore into {table} values ({placeholders})", rows  # noqa: S608
                    )
            dst.commit()
        finally:
            dst.close()
    finally:
        src.close()


def instagram_archive_row_count(archive_path: Path) -> int:
    # R1 (revue 2026-08-03, cycle 3) : `st_size > 0` etait un FAUX signal —
    # une base SQLite fraichement creee (CREATE TABLE sans aucune ligne, cf
    # merge_instagram_archive) occupe deja st_size == 8192 (une page SQLite),
    # NON ZERO, avant meme la premiere ligne inseree. Compte reellement les
    # LIGNES de chaque table (meme pattern generique que merge_instagram_archive
    # ci-dessus : lit sqlite_master, jamais un nom de table code en dur).
    # Sources (2026-08-03, R8) : doc officielle gallery-dl —
    # https://gdl-org.github.io/docs/configuration.html#extractor-archive
    # ("File to store IDs... an SQLite3 database" ; "archive-table ... Default:
    # \"archive\"", format string donc potentiellement autre que "archive").
    # Aucun marqueur stdout/-v documente pour un skip archive dans cette meme
    # doc, et gallery-dl n'est pas installe sur waza (aucun binaire local pour
    # confronter un marqueur reel, cf commande de sonde dans le commit) —
    # fallback retenu : ce compte de lignes sert de PREUVE D'AUDIT
    # (manifest["archive_rows_seeded"]), jamais de discriminant a lui seul
    # (le discriminant reel est per-job, cf process_instagram_job/R1).
    if not archive_path.exists():
        return 0
    try:
        conn = sqlite3.connect(archive_path)
        try:
            tables = [
                row[0]
                for row in conn.execute(
                    "select name from sqlite_master where type='table' "
                    "and name not like 'sqlite\\_%' escape '\\'"
                )
            ]
            total = 0
            for table in tables:
                total += conn.execute(
                    f'select count(*) from "{table}"'  # noqa: S608 (table name from sqlite_master, not external input)
                ).fetchone()[0]
            return total
        finally:
            conn.close()
    except sqlite3.Error:
        return 0


def write_manifest_record(job_id: str, manifest: dict) -> Path:
    # M7 : copie de traçabilite par job_id, ecrite pour TOUT etat terminal —
    # independante du bundle outgoing/ (qui peut etre partage entre jobs par
    # dedup de digest) et independante de rejects/ (best-effort, cf
    # archive_manifest_snapshot). jobs.manifest_path pointe TOUJOURS ici.
    part = MANIFESTS / f".{job_id}.json.part"
    part.write_text(json.dumps(manifest, sort_keys=True) + "\n")
    final = MANIFESTS / f"{job_id}.json"
    part.replace(final)
    return final


def deliver_instagram_bundle(files_info: list[dict], workdir: Path, manifest: dict) -> Path:
    # Identite de bundle multi-fichiers : sha256 de la concatenation triee des
    # sha256 par fichier (carrousel = plusieurs medias -> une seule livraison
    # atomique). Meme discipline B1 que deliver_bundle : construit sous un
    # repertoire cache puis publie par un seul rename() de repertoire.
    bundle_digest = hashlib.sha256(
        "".join(sorted(info["sha256"] for info in files_info)).encode("utf-8")
    ).hexdigest()
    bundle_final = OUTGOING / bundle_digest
    if bundle_final.exists():
        return bundle_final
    bundle_part = OUTGOING / f".{bundle_digest}.part"
    shutil.rmtree(bundle_part, ignore_errors=True)
    bundle_part.mkdir(mode=0o750, exist_ok=True)
    for info in files_info:
        source = workdir / info["filename"]
        source.replace(bundle_part / info["filename"])
    (bundle_part / "manifest.json").write_text(json.dumps(manifest, sort_keys=True) + "\n")
    bundle_part.replace(bundle_final)
    return bundle_final


class InstagramUsernameRejected(RuntimeError):
    """H4 : au moins un media acquis a un username sidecar CONFIRME different
    du handle autorise. Rejet APRES acquisition, rien livre — jamais un
    simple echec retriable (le contournement est definitif pour ce job, pas
    transitoire)."""


class InstagramUsernameUnavailable(RuntimeError):
    """M-G (revue 2026-08-03, cycle 2) : au moins un media acquis n'expose
    aucun username sidecar (ni cle racine 'username', ni repli
    owner.username/owner_username) — impossible de confirmer OU d'infirmer
    l'appartenance au handle autorise. Retriable (borne par MAX_ATTEMPTS via
    handle_failure), CONTRAIREMENT a InstagramUsernameRejected (mismatch
    confirme, terminal) : un champ absent peut resulter d'une reponse
    gallery-dl partielle/transitoire, pas d'un contournement avere."""


def _finalize_instagram_job(
    db: sqlite3.Connection, job_id: str, manifest: dict, workdir: Path, *, state: str, error: str | None = None
) -> None:
    # M7 : ecrit systematiquement le manifeste de traçabilite par job_id
    # (manifests/<job_id>.json) pour TOUT etat terminal, et c'est CE chemin
    # que jobs.manifest_path reference desormais (jamais le bundle
    # outgoing/<digest>/manifest.json, qui peut etre partage entre plusieurs
    # job_id par dedup de digest de contenu).
    manifest["state"] = state
    if error is not None:
        manifest["reason"] = error
    record_path = write_manifest_record(job_id, manifest)
    # M-B (revue 2026-08-03, cycle 2) : un succes (state == "done", y compris
    # le cas H-B "skipped_already_acquired") ne doit JAMAIS produire de
    # snapshot sous rejects/ — ce repertoire est reserve aux etats
    # rejected/blocked/failed(_attempt). Le manifeste de traçabilite
    # d'un succes vit UNIQUEMENT dans manifests/<job_id>.json.
    if state != "done":
        archive_manifest_snapshot(job_id, record_path)
    update_job(db, job_id, state=state, error=error, manifest_path=str(record_path))
    shutil.rmtree(workdir, ignore_errors=True)


def process_instagram_job(db: sqlite3.Connection, job_id: str, job: dict, domain: str, now: int) -> None:
    if shutil.disk_usage(ROOT).free < MIN_FREE_BYTES:
        raise RuntimeError("disk_low")
    workdir = WORK / job_id
    # A3 : purge d'une tentative precedente avortee AVANT de relancer l'adapter.
    shutil.rmtree(workdir, ignore_errors=True)
    workdir.mkdir(parents=True, exist_ok=True)
    dl = workdir / "dl"
    dl.mkdir(parents=True, exist_ok=True)
    job_range = job.get("range") or INSTAGRAM_RANGE_DEFAULT
    allowed, reject_reason = instagram_job_allowed(job, domain)
    manifest = {
        "schema": "prisme.source-bundle.v2",
        "job_id": job_id,
        "url": job["url"],
        "adapter": "instagram",
        "handle": job.get("handle"),
        "range": job_range,
        "requested_at": datetime.now(timezone.utc).isoformat(),
        "allowlist_match": allowed,
        # M8 : "input_url_only" par defaut (seule l'URL/handle DECLARE a ete
        # verifie) -> promu "verified_username" plus bas UNIQUEMENT apres
        # l'enforcement post-acquisition H4 (tous les usernames sidecar
        # confirmes == handle autorise).
        "allowlist_scope": "input_url_only",
    }
    # Manifeste ecrit AVANT tout telechargement (exigence design).
    write_manifest(workdir, manifest)
    if not allowed:
        _finalize_instagram_job(db, job_id, manifest, workdir, state="rejected", error=reject_reason)
        return
    if not _INSTAGRAM_RANGE_RE.fullmatch(job_range):
        _finalize_instagram_job(db, job_id, manifest, workdir, state="rejected", error="invalid_range")
        return
    range_lower = int(job_range.split("-")[0])
    range_upper = int(job_range.split("-")[1])
    # H-C (revue 2026-08-03, cycle 2) : plafond dur AVANT tout appel
    # gallery-dl — sans cette borne, une deadline arbitraire (1-99999 ~= 1,5e7
    # s) gele le pipeline mono-thread + verrouille en singleton (M1), y
    # compris le heartbeat, pour une duree demesuree.
    if range_upper > INSTAGRAM_RANGE_MAX_UPPER:
        manifest["range_upper"] = range_upper
        _finalize_instagram_job(db, job_id, manifest, workdir, state="rejected", error="range_upper_too_large")
        return
    manifest["range_lower"] = range_lower
    manifest["range_upper"] = range_upper
    handle = (job.get("handle") or "").lower()
    # H5/H6 : archive SCOPEE PAR JOB (workdir), seedee depuis l'archive
    # persistante partagee (dedup cross-job connue au moment ou ce job
    # demarre) mais jamais ecrite directement dedans — cf fetch_instagram.
    job_archive = workdir / "gallery-dl-archive.sqlite3"
    # R1 (revue 2026-08-03, cycle 3) : l'ancien signal
    # (archive_seeded_nonempty = st_size > 0) etait GLOBAL — vrai des la 1re
    # livraison de la vie du canary, pour N'IMPORTE QUEL job, sans le moindre
    # rapport avec l'URL/handle de CE job precis (une autre porte vers la
    # perte silencieuse H5 : un job qui n'a REELLEMENT rien acquis devenait
    # `done`+skipped, jamais `failed`, jamais revu). archive_rows_seeded
    # (compte REEL de lignes, cf instagram_archive_row_count) reste calcule
    # ci-dessous comme preuve d'audit dans le manifeste, mais n'est PLUS le
    # discriminant — cf la decision "prior_delivery" plus bas (scopee a
    # l'URL de CE job via la table jobs, jamais l'archive globale).
    archive_rows_seeded = 0
    if INSTAGRAM_ARCHIVE_FILE.exists():
        shutil.copyfile(INSTAGRAM_ARCHIVE_FILE, job_archive)
        archive_rows_seeded = instagram_archive_row_count(job_archive)
    try:
        files_info = fetch_instagram(db, job["url"], dl, job_range, job_archive, range_upper)
        mark_domain_fetch(db, domain)
        mark_domain_fetch(db, f"{domain}#{handle}")
        if files_info:
            observed_usernames = sorted(
                {(info["metadata"].get("username") or "<absent>") for info in files_info}
            )
            # M-G (revue 2026-08-03, cycle 2) : distinguer absence (retriable,
            # cf InstagramUsernameUnavailable) de mismatch confirme (terminal,
            # InstagramUsernameRejected) — un media SANS username sidecar
            # n'est ni une preuve d'appartenance ni une preuve de
            # contournement, alors qu'un username CONFIRME different du
            # handle autorise l'est.
            absent = [info for info in files_info if not info["metadata"].get("username")]
            mismatched = [
                info for info in files_info
                if info["metadata"].get("username")
                and info["metadata"]["username"].lower() != handle
            ]
            if absent:
                manifest["username_check"] = {"expected": handle, "observed": observed_usernames}
                raise InstagramUsernameUnavailable("username_absent")
            if mismatched:
                manifest["username_check"] = {"expected": handle, "observed": observed_usernames}
                raise InstagramUsernameRejected("username_not_allowlisted")
    except InstagramBlocked as error:
        # Arret propre : state=blocked est TERMINAL (cf scan_jobs), jamais
        # repasse par handle_failure/backoff — pas de retry automatique.
        mark_domain_fetch(db, domain)
        mark_domain_fetch(db, f"{domain}#{handle}")
        _finalize_instagram_job(db, job_id, manifest, workdir, state="blocked", error=str(error))
    except InstagramUsernameRejected as error:
        # H4 : rejet TERMINAL (pas de retry — un tiers non-autorise ne
        # devient jamais autorise en re-tentant). Rien n'est livre : dl/
        # est purge avec le reste du workdir ci-dessous.
        mark_domain_fetch(db, domain)
        mark_domain_fetch(db, f"{domain}#{handle}")
        _finalize_instagram_job(db, job_id, manifest, workdir, state="rejected", error=str(error))
    except Exception as error:  # noqa: BLE001
        # M-G : InstagramUsernameUnavailable (username absent) tombe ICI,
        # meme discipline retriable/backoff que toute autre erreur transitoire
        # (borne par MAX_ATTEMPTS via handle_failure) — jamais terminal
        # directement.
        mark_domain_fetch(db, domain)
        mark_domain_fetch(db, f"{domain}#{handle}")
        manifest["state"] = "failed_attempt"
        manifest["reason"] = str(error)
        write_manifest(workdir, manifest)
        record_path = write_manifest_record(job_id, manifest)
        archive_manifest_snapshot(job_id, record_path)
        handle_failure(db, job_id, now, error)
        update_job(db, job_id, manifest_path=str(record_path))
        shutil.rmtree(workdir, ignore_errors=True)
    else:
        if not files_info:
            # H-B/R1 (revue 2026-08-03, cycles 2+3) : files_info==[] signifie
            # normalement "post deja acquis" (idempotence --download-archive).
            # Le seul discriminant fiable et SCOPE A CE JOB (R1 — jamais une
            # taille de fichier ni une presence d'archive GLOBALE) est : un
            # AUTRE job_id, portant EXACTEMENT LA MEME url, a-t-il deja
            # atteint l'etat terminal "done" AVANT ce job ? La table jobs est
            # la source de verite retenue plutot que outgoing/ (rsync
            # --remove-source-files draine outgoing/ apres transfert vers
            # banga, cf prisme-transfer.sh.j2 — une preuve fondee sur
            # l'existence physique du bundle serait fausse des le premier
            # transfert reussi) ou que l'archive gallery-dl elle-meme (aucun
            # marqueur stdout documente pour confirmer un skip PAR URL — cf
            # instagram_archive_row_count/R8 ci-dessus ; archive_rows_seeded
            # reste journalise comme preuve d'audit, jamais comme
            # discriminant).
            prior_delivery = db.execute(
                "select 1 from jobs where url=? and job_id!=? and state='done' limit 1",
                (job["url"], job_id),
            ).fetchone()
            manifest["archive_rows_seeded"] = archive_rows_seeded
            if prior_delivery is not None:
                # L5 : contrat H-B FIGE — un `done` par dedup ne porte JAMAIS
                # files/delivered_count/output_path (aucun media n'a ete
                # acquis PAR CE job ; cf commentaire schema plus haut dans le
                # fichier). skipped_already_acquired + partial +
                # partial_reason="archive_overlap" sont les SEULS marqueurs de
                # ce contrat, avec archive_rows_seeded en preuve d'audit
                # annexe.
                manifest["skipped_already_acquired"] = True
                manifest["partial"] = True
                manifest["partial_reason"] = "archive_overlap"
                _finalize_instagram_job(db, job_id, manifest, workdir, state="done")
                return
            # Aucune livraison anterieure de CETTE url n'explique ce resultat
            # vide -> echec REEL, terminal (jamais handle_failure — meme
            # doctrine H7 anti-retry-agressif : un resultat deterministe ne
            # doit pas re-frapper Instagram en boucle).
            _finalize_instagram_job(
                db, job_id, manifest, workdir,
                state="failed", error="instagram_empty_result_no_prior_delivery",
            )
            return
        # H4 : tous les usernames sidecar ont ete confirmes == handle
        # autorise (aucun mismatch/absence, cf try ci-dessus) -> promotion du
        # scope.
        manifest["allowlist_scope"] = "verified_username"
        manifest["files"] = files_info
        manifest["delivered_count"] = len(files_info)
        # H-A (revue 2026-08-03, cycle 2) : regression 488c3d8 — cette
        # branche de succes ne passe jamais par _finalize_instagram_job (elle
        # ecrit le manifeste directement) et avait perdu manifest["state"] =
        # "done" en route -> schema source-bundle.v2 divergent du bundle
        # http/ytdlp (qui posent TOUJOURS "state") et de la propre assertion
        # verify.yml (state == "done").
        manifest["state"] = "done"
        # M-A (revue 2026-08-03, cycle 2) : le calcul original
        # (len(files_info) < range_upper) ignorait la borne BASSE de la plage
        # -> quasi TOUJOURS vrai (bruit permanent : range "10-12" avec 3
        # medias livres etait signale partial=true a tort). span =
        # upper-lower+1 est le nombre de posts REELLEMENT demandes.
        span = range_upper - range_lower + 1
        manifest["partial"] = len(files_info) < span
        if manifest["partial"]:
            manifest["partial_reason"] = "fewer_items_than_requested"
        bundle = deliver_instagram_bundle(files_info, dl, manifest)
        # H5/H6 : fusion vers l'archive persistante SEULEMENT apres livraison
        # reussie — un crash avant ce point laisse l'archive partagee
        # intacte (prochaine tentative repart d'un etat coherent, jamais
        # d'un faux "deja acquis").
        merge_instagram_archive(job_archive, INSTAGRAM_ARCHIVE_FILE)
        record_path = write_manifest_record(job_id, manifest)
        # M-B : succes -> AUCUN snapshot rejects/ (cf _finalize_instagram_job).
        shutil.rmtree(workdir, ignore_errors=True)
        update_job(
            db, job_id, state="done", output_path=str(bundle),
            manifest_path=str(record_path),
        )


def handle_failure(db: sqlite3.Connection, job_id: str, now: int, error: Exception) -> None:
    row = db.execute("select attempts from jobs where job_id=?", (job_id,)).fetchone()
    attempts = (row["attempts"] if row else 0) + 1
    if attempts >= MAX_ATTEMPTS:
        update_job(db, job_id, state="failed", attempts=attempts, error=str(error))
    else:
        delay = RETRY_BACKOFF_SECONDS * (2 ** (attempts - 1))
        update_job(
            db, job_id, state="retry_wait", attempts=attempts,
            next_attempt_at=now + delay, error=str(error),
        )


def archive_manifest_snapshot(job_id: str, manifest_path: Path) -> None:
    # A3 : conserve une trace du manifeste final pour debug, hors du
    # repertoire de travail purge juste apres. Best-effort : un echec de
    # copie ne doit jamais empecher la purge (deja passe le point de non-retour
    # fonctionnel du job).
    try:
        dest_dir = REJECTS / job_id
        dest_dir.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(manifest_path, dest_dir / "manifest.json")
    except OSError:
        pass


def deliver_bundle(digest: str, filename: str, source: Path, manifest: dict) -> Path:
    # B1 : bundle construit entierement (media + manifest) sous un repertoire
    # cache ".<sha>.part/" puis publie par un seul rename() de repertoire,
    # atomique sur un meme filesystem. Aucun lecteur externe (rsync sur
    # outgoing/) ne peut donc jamais observer un bundle partiel ou depourvu
    # de manifest.json.
    bundle_final = OUTGOING / digest
    if bundle_final.exists():
        # Contenu deja livre par une tentative/job precedent (dedup par
        # sha256) : rien a refaire, l'appelant purge le workdir courant.
        return bundle_final
    bundle_part = OUTGOING / f".{digest}.part"
    shutil.rmtree(bundle_part, ignore_errors=True)
    bundle_part.mkdir(mode=0o750, exist_ok=True)
    source.replace(bundle_part / filename)
    (bundle_part / "manifest.json").write_text(json.dumps(manifest, sort_keys=True) + "\n")
    bundle_part.replace(bundle_final)
    return bundle_final


def process_job(db: sqlite3.Connection, job_id: str, job: dict, domain: str, now: int) -> None:
    if shutil.disk_usage(ROOT).free < MIN_FREE_BYTES:
        raise RuntimeError("disk_low")
    workdir = WORK / job_id
    # A3 : purge d'une tentative precedente avortee (crash, kill -9, panne
    # secteur) AVANT de relancer l'adapter — jamais de residu entre deux
    # tentatives d'un meme job.
    shutil.rmtree(workdir, ignore_errors=True)
    workdir.mkdir(parents=True, exist_ok=True)
    # A1 : le manifeste vit HORS du repertoire de telechargement (dl/) : le
    # delta produit par l'adapter ne peut donc jamais inclure le manifeste
    # lui-meme (REX : un tri alphabetique global pouvait auparavant
    # selectionner manifest.json a la place du media reel -> perte silencieuse).
    dl = workdir / "dl"
    dl.mkdir(parents=True, exist_ok=True)
    allowed = domain_allowed(domain)
    manifest = {
        "schema": "prisme.source-bundle.v2",
        "job_id": job_id,
        "url": job["url"],
        "adapter": job["adapter"],
        "requested_at": datetime.now(timezone.utc).isoformat(),
        "allowlist_match": allowed,
        "user_agent": HTTP_USER_AGENT,
    }
    if job["adapter"] == "ytdlp":
        manifest["allowlist_scope"] = "input_url_only"
    if job.get("note"):
        manifest["note"] = job["note"]
    # Manifeste ecrit AVANT tout telechargement (exigence design), dans le
    # staging par job_id : le sha256 final n'est connu qu'apres coup, et un
    # job rejete n'en aura jamais un. Ce fichier workdir/manifest.json est
    # PUREMENT une trace de debug pre-decision — jobs.manifest_path (M-C,
    # revue 2026-08-03 cycle 2) pointe TOUJOURS vers manifests/<job_id>.json
    # (write_manifest_record), jamais vers un chemin sous workdir/ (supprime
    # par le rmtree ci-dessous) ni vers le bundle outgoing/ (partage entre
    # jobs par dedup de digest) — meme discipline que l'adapter Instagram.
    write_manifest(workdir, manifest)
    if not allowed:
        manifest["state"] = "rejected"
        manifest["reason"] = "domain_not_allowlisted"
        record_path = write_manifest_record(job_id, manifest)
        archive_manifest_snapshot(job_id, record_path)
        update_job(
            db, job_id, state="rejected", error="domain_not_allowlisted",
            manifest_path=str(record_path),
        )
        shutil.rmtree(workdir, ignore_errors=True)
        return
    try:
        if job["adapter"] == "http":
            digest, filename, content_type = fetch_http(job["url"], dl)
        else:
            digest, filename = fetch_ytdlp(job["url"], dl)
            content_type = None
        mark_domain_fetch(db, domain)
    except AllowlistViolation as error:
        mark_domain_fetch(db, domain)
        manifest["state"] = "rejected"
        manifest["reason"] = str(error)
        record_path = write_manifest_record(job_id, manifest)
        archive_manifest_snapshot(job_id, record_path)
        update_job(
            db, job_id, state="rejected", error=str(error),
            manifest_path=str(record_path),
        )
        shutil.rmtree(workdir, ignore_errors=True)
    except Exception as error:  # noqa: BLE001
        mark_domain_fetch(db, domain)
        manifest["state"] = "failed_attempt"
        manifest["reason"] = str(error)
        record_path = write_manifest_record(job_id, manifest)
        archive_manifest_snapshot(job_id, record_path)
        handle_failure(db, job_id, now, error)
        update_job(db, job_id, manifest_path=str(record_path))
        shutil.rmtree(workdir, ignore_errors=True)
    else:
        manifest["state"] = "done"
        manifest["sha256"] = digest
        manifest["filename"] = filename
        if content_type:
            manifest["content_type"] = content_type
        bundle = deliver_bundle(digest, filename, dl / filename, manifest)
        record_path = write_manifest_record(job_id, manifest)
        # M-B (meme doctrine que l'adapter Instagram) : aucun snapshot
        # rejects/ pour un succes.
        shutil.rmtree(workdir, ignore_errors=True)
        update_job(
            db, job_id, state="done", output_path=str(bundle),
            manifest_path=str(record_path),
        )


def scan_jobs(db: sqlite3.Connection) -> None:
    for path in sorted(JOBS.glob("*.json")):
        touch_heartbeat(db)
        now = int(time.time())
        raw = path.read_bytes()
        job_id = hashlib.sha256(raw).hexdigest()
        row = db.execute(
            "select state, next_attempt_at, domain from jobs where job_id=?", (job_id,)
        ).fetchone()
        if row is not None and row["state"] in ("done", "rejected", "failed", "blocked"):
            # A3 : GC du fichier job une fois l'etat terminal atteint (le
            # manifeste/bundle correspondant vit deja dans outgoing/ ou
            # rejects/ — le fichier jobs/*.json n'a plus de raison d'exister).
            # "blocked" (Instagram : challenge/2FA/rate-limit/auth) est
            # TERMINAL au meme titre : sans ce GC le job serait relu a chaque
            # passe et re-frapperait Instagram toutes les POLL_SECONDS —
            # exactement le retry agressif interdit par design.
            path.unlink(missing_ok=True)
            continue
        if row is not None and row["state"] == "retry_wait" and now < row["next_attempt_at"]:
            continue
        job = load_job(path)
        if job is None:
            if row is None:
                db.execute(
                    """insert into jobs(job_id,url,adapter,state,error,created_at,updated_at)
                    values(?,?,?,?,?,?,?)""",
                    (job_id, "", "", "rejected", "invalid_job_payload", now, now),
                )
                db.commit()
            continue
        parsed = urllib.parse.urlsplit(job["url"])
        domain = (parsed.hostname or "").lower()
        if row is None:
            db.execute(
                """insert into jobs(job_id,url,adapter,note,state,attempts,
                next_attempt_at,domain,created_at,updated_at)
                values(?,?,?,?,?,0,0,?,?,?)""",
                (job_id, job["url"], job["adapter"], job["note"], "pending", domain, now, now),
            )
            db.commit()
        if job["adapter"] == "instagram":
            handle = (job.get("handle") or "").lower()
            # Rate-limit PAR COMPTE ET PAR DOMAINE (MED revue Codex) : deux
            # cles distinctes dans domain_state ("instagram.com" et
            # "instagram.com#<handle>"), le seuil le plus contraignant gagne
            # (les deux doivent etre respectes).
            if domain and rate_limited(db, domain, now, INSTAGRAM_RATE_LIMIT_SECONDS):
                continue
            if handle and rate_limited(db, f"{domain}#{handle}", now, INSTAGRAM_RATE_LIMIT_SECONDS):
                continue
            try:
                process_instagram_job(db, job_id, job, domain, now)
            except Exception as error:
                print(json.dumps({"event": "acquisition_error", "code": type(error).__name__, "job_id": job_id}))
                handle_failure(db, job_id, now, error)
            continue
        if domain and rate_limited(db, domain, now):
            continue
        try:
            process_job(db, job_id, job, domain, now)
        except Exception as error:
            print(json.dumps({"event": "acquisition_error", "code": type(error).__name__, "job_id": job_id}))
            handle_failure(db, job_id, now, error)


def purge_old_artifacts(now: int) -> None:
    # M-F (revue 2026-08-03, cycle 2) : manifests/ (write_manifest_record) et
    # rejects/ (archive_manifest_snapshot) n'ont aucune retention native — un
    # canary de longue duree accumule indefiniment ces traces. Purge par age
    # (mtime du fichier/repertoire), best-effort (une erreur de purge ne doit
    # jamais interrompre le worker).
    cutoff = now - INSTAGRAM_ARTIFACT_RETENTION_SECONDS
    for base in (MANIFESTS, REJECTS):
        if not base.exists():
            continue
        for entry in base.iterdir():
            try:
                mtime = entry.stat().st_mtime
            except OSError:
                continue
            if mtime >= cutoff:
                continue
            try:
                if entry.is_dir():
                    shutil.rmtree(entry, ignore_errors=True)
                else:
                    entry.unlink(missing_ok=True)
            except OSError:
                continue


def main() -> None:
    acquire_singleton_lock()
    db = connect()
    once = "--once" in sys.argv or os.environ.get("PRISME_FETCHER_ONESHOT") == "1"
    while not STOP:
        touch_heartbeat(db)
        purge_old_artifacts(int(time.time()))
        for source in sorted(INCOMING.glob("*.ready")):
            try:
                process_fixture(db, source)
            except Exception as error:
                print(json.dumps({"event": "acquisition_error", "code": type(error).__name__}))
        scan_jobs(db)
        if once:
            break
        time.sleep(POLL_SECONDS)
    db.close()


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
main()
