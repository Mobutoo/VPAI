#!/bin/bash
# {{ ansible_managed }}
# Pre-backup script for {{ project_display_name }}
# Executed by cron at {{ backup_pre_script_cron_hour }}:{{ backup_pre_script_cron_minute }} BEFORE Zerobyte backup at 03:00

set -euo pipefail

export PGPASSWORD='{{ postgresql_password }}'

BACKUP_DIR="{{ backup_base_dir }}"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
PROJECT="{{ project_name }}"

echo "[$(date)] Starting pre-backup..."

# === PostgreSQL dump ===
# DB list generated from postgresql_databases (roles/postgresql) + Plane (plane_production)
# + content_factory (created by roles/content-factory, NOT in postgresql_databases)
echo "[$(date)] Dumping PostgreSQL databases..."
{# temporal / temporal_visibility VOLONTAIREMENT exclues (decision 2026-07-02 : perte des
   runs Temporal en vol acceptee, workflows relancables ;
   cf content-factory/docs/decisions/2026-07-02-decisions-audit.md) #}
{% set backup_pg_databases = (postgresql_databases | default([]) | map(attribute='name') | list) + ['plane_production', 'content_factory'] %}
for DB in {{ backup_pg_databases | unique | join(' ') }}; do
  # Garde par-DB : une base absente (service décommissionné) ou un dump en échec
  # ne doit PAS avorter tout le backup (set -e). WARNING visible, on continue.
  if ! docker exec -e PGPASSWORD="${PGPASSWORD}" "${PROJECT}_postgresql" \
      psql -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname='${DB}'" 2>/dev/null | grep -q 1; then
    echo "[$(date)] WARNING: base ${DB} absente — dump ignoré"
    continue
  fi
  if docker exec -e PGPASSWORD="${PGPASSWORD}" "${PROJECT}_postgresql" \
      pg_dump -U postgres -Fc --file="/tmp/${DB}_backup.dump" "${DB}"; then
    docker cp "${PROJECT}_postgresql:/tmp/${DB}_backup.dump" \
      "${BACKUP_DIR}/pg_dump/${DB}-${TIMESTAMP}.dump"
    docker exec "${PROJECT}_postgresql" rm -f "/tmp/${DB}_backup.dump"
  else
    echo "[$(date)] WARNING: pg_dump a échoué pour ${DB}"
  fi
done
echo "[$(date)] PostgreSQL dump completed"

# === Redis BGSAVE ===
# REX 2026-07-23 : dump.rdb appartient à l'uid du conteneur redis (999, mode 0600) —
# illisible par l'utilisateur du script → un `cp` host faisait avorter TOUT le script
# (set -e) avant Qdrant/n8n/Grafana. `docker cp` passe par le daemon (root), contourne
# le problème. Bloc entièrement non-fatal : un échec = WARNING, on continue.
echo "[$(date)] Triggering Redis BGSAVE..."
if docker exec "${PROJECT}_redis" \
    sh -c 'REDISCLI_AUTH="{{ redis_password }}" redis-cli BGSAVE' >/dev/null 2>&1; then
  # Polling au lieu d'un sleep fixe : attend la fin réelle du BGSAVE (max 30s)
  for i in $(seq 1 30); do
    BGSAVE_DONE=$(docker exec "${PROJECT}_redis" \
      sh -c 'REDISCLI_AUTH="{{ redis_password }}" redis-cli INFO persistence' 2>/dev/null | \
      grep -c '^rdb_bgsave_in_progress:0' || true)
    [ "${BGSAVE_DONE}" = "1" ] && break
    sleep 1
  done
  if docker cp "${PROJECT}_redis:/data/dump.rdb" \
      "${BACKUP_DIR}/redis/dump-${TIMESTAMP}.rdb" 2>/dev/null \
      && [ -s "${BACKUP_DIR}/redis/dump-${TIMESTAMP}.rdb" ]; then
    echo "[$(date)] Redis snapshot completed"
  else
    echo "[$(date)] WARNING: Redis snapshot vide ou échec de copie"
  fi
else
  echo "[$(date)] WARNING: Redis BGSAVE a échoué"
fi

# === Qdrant snapshots ===
# NOTE: Qdrant image has no wget/curl — call API from host via Docker network
echo "[$(date)] Creating Qdrant snapshot..."
# Qdrant est sur plusieurs réseaux Docker : prendre le PREMIER IP (séparateur espace
# + awk) au lieu de concaténer toutes les IPs (URL invalide → curl timeout → set -e
# avortait n8n+TREK). Bloc entièrement non-fatal : un échec = WARNING, on continue.
QDRANT_IP=$(docker inspect -f '{{ '{{' }}range .NetworkSettings.Networks{{ '}}' }}{{ '{{' }}.IPAddress{{ '}}' }} {{ '{{' }}end{{ '}}' }}' "${PROJECT}_qdrant" 2>/dev/null | awk '{print $1}')
if [ -n "${QDRANT_IP}" ] && SNAPSHOT_RESULT=$(curl -sS --max-time 30 \
    -X POST "http://${QDRANT_IP}:6333/snapshots" \
    -H "api-key: {{ qdrant_api_key }}" 2>/dev/null); then
  SNAPSHOT_NAME=$(echo "${SNAPSHOT_RESULT}" | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4 || true)
  if [ -n "${SNAPSHOT_NAME}" ]; then
    echo "${SNAPSHOT_NAME}" > "${BACKUP_DIR}/qdrant/latest-snapshot-${TIMESTAMP}.txt"
    echo "[$(date)] Qdrant snapshot created: ${SNAPSHOT_NAME}"

    # Rétention locale = 1 full snapshot (l'historique vit off-site via Zerobyte).
    # Supprime tous les full snapshots SAUF celui qui vient d'être créé. Non
    # bloquant : un échec de listage/suppression ne doit pas faire échouer le backup.
    echo "[$(date)] Purge des anciens snapshots Qdrant (rétention locale = 1)..."
    if LIST_RESULT=$(curl -sS --max-time 30 \
        "http://${QDRANT_IP}:6333/snapshots" \
        -H "api-key: {{ qdrant_api_key }}" 2>/dev/null); then
      ALL_SNAPSHOTS=$(echo "${LIST_RESULT}" | grep -o '"name":"[^"]*"' | cut -d'"' -f4)
      for SNAP in ${ALL_SNAPSHOTS}; do
        if [ "${SNAP}" != "${SNAPSHOT_NAME}" ]; then
          if curl -fsS --max-time 30 -X DELETE \
              "http://${QDRANT_IP}:6333/snapshots/${SNAP}" \
              -H "api-key: {{ qdrant_api_key }}" >/dev/null 2>&1; then
            echo "[$(date)] Ancien snapshot Qdrant supprimé: ${SNAP}"
          else
            echo "[$(date)] WARNING: suppression snapshot Qdrant échouée: ${SNAP}"
          fi
        fi
      done
    else
      echo "[$(date)] WARNING: listage snapshots Qdrant échoué — purge ignorée"
    fi
  else
    echo "[$(date)] WARNING: Qdrant snapshot name vide"
  fi
else
  echo "[$(date)] WARNING: Qdrant snapshot échoué (IP=${QDRANT_IP:-?}) — étape ignorée"
fi

# === OpenClaw workspace backup ===
{% if openclaw_volume_isolation | default(false) %}
echo "[$(date)] Backing up OpenClaw workspace..."
mkdir -p "${BACKUP_DIR}/openclaw"
# Backup workspace (user content — books, prospection, output)
tar -czf "${BACKUP_DIR}/openclaw/workspace-${TIMESTAMP}.tar.gz" \
  -C "{{ openclaw_workspace_dir }}" . 2>/dev/null || \
  echo "[$(date)] WARNING: OpenClaw workspace backup failed"
# Backup state (sessions, memory — not canvas/cron which are ephemeral)
tar -czf "${BACKUP_DIR}/openclaw/state-${TIMESTAMP}.tar.gz" \
  -C "{{ openclaw_state_dir }}" sessions memory 2>/dev/null || \
  echo "[$(date)] WARNING: OpenClaw state backup failed"
echo "[$(date)] OpenClaw backup completed"
{% endif %}

# === TREK data backup (SQLite DB + uploads, host volumes) ===
# trip.<domain> — public service, SQLite in {{ trek_data_dir }} + uploads in {{ trek_uploads_dir }}
echo "[$(date)] Backing up TREK data..."
mkdir -p "{{ backup_trek_dir }}"
tar -czf "{{ backup_trek_dir }}/data-${TIMESTAMP}.tar.gz" \
  -C "{{ trek_data_dir }}" . 2>/dev/null || \
  echo "[$(date)] WARNING: TREK data backup failed"
tar -czf "{{ backup_trek_dir }}/uploads-${TIMESTAMP}.tar.gz" \
  -C "{{ trek_uploads_dir }}" . 2>/dev/null || \
  echo "[$(date)] WARNING: TREK uploads backup failed"
echo "[$(date)] TREK backup completed"

# === n8n workflow export ===
# REX 2026-07-23 : `/home/node/.n8n/backups/` n'existe PAS dans le conteneur —
# `export:workflow --output=...` échouait (ENOENT) mais les `|| true` masquaient
# l'échec sans jamais vérifier le fichier produit. mkdir -p + vérif non-vide.
echo "[$(date)] Exporting n8n workflows..."
if docker exec "${PROJECT}_n8n" mkdir -p /home/node/.n8n/backups \
    && docker exec "${PROJECT}_n8n" \
      n8n export:workflow --all \
      --output="/home/node/.n8n/backups/workflows.json" >/dev/null 2>&1 \
    && docker cp "${PROJECT}_n8n:/home/node/.n8n/backups/workflows.json" \
      "${BACKUP_DIR}/n8n/workflows-${TIMESTAMP}.json" 2>/dev/null \
    && [ -s "${BACKUP_DIR}/n8n/workflows-${TIMESTAMP}.json" ]; then
  echo "[$(date)] n8n export completed"
else
  echo "[$(date)] WARNING: n8n export vide ou échoué"
fi

# === Grafana dashboard export ===
echo "[$(date)] Exporting Grafana dashboards..."
GRAFANA_URL="http://localhost:3000"
GRAFANA_API_KEY="{{ grafana_admin_password }}"
DASHBOARD_UIDS=$(docker exec "${PROJECT}_grafana" \
  wget -qO- --header="Authorization: Basic $(echo -n 'admin:'"${GRAFANA_API_KEY}" | base64)" \
  "${GRAFANA_URL}/api/search?type=dash-db" 2>/dev/null | \
  grep -o '"uid":"[^"]*"' | cut -d'"' -f4) || true

if [ -n "${DASHBOARD_UIDS}" ]; then
  mkdir -p "${BACKUP_DIR}/grafana/dashboards-${TIMESTAMP}"
  for UID in ${DASHBOARD_UIDS}; do
    docker exec "${PROJECT}_grafana" \
      wget -qO- --header="Authorization: Basic $(echo -n 'admin:'"${GRAFANA_API_KEY}" | base64)" \
      "${GRAFANA_URL}/api/dashboards/uid/${UID}" \
      > "${BACKUP_DIR}/grafana/dashboards-${TIMESTAMP}/${UID}.json" 2>/dev/null || true
  done
  echo "[$(date)] Grafana dashboards exported"
else
  echo "[$(date)] WARNING: No Grafana dashboards found to export"
fi

echo "[$(date)] Pre-backup completed successfully"

{% if backup_heartbeat_url | default('') | length > 0 %}
# === Heartbeat ping ===
curl -fsS --max-time 10 "{{ backup_heartbeat_url }}" > /dev/null 2>&1 || \
  echo "[$(date)] WARNING: Heartbeat ping failed"
{% endif %}
