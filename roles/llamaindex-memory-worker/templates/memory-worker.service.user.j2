[Unit]
Description=LlamaIndex memory worker (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory={{ memory_worker_install_dir }}
EnvironmentFile={{ memory_worker_env_file }}
ExecStartPre={{ memory_worker_wait_calm_script }}
ExecStart={{ memory_worker_run_report_script }} --mode {{ memory_worker_index_mode }}
Nice=19
IOSchedulingClass=idle

# Un arrêt DÉLIBÉRÉ (systemctl stop, ou la coupure de fin de fenêtre de nuit) tue
# d'abord run-and-report.sh, donc systemd voit son main process mourir par signal
# et marque l'unité `failed` — un faux positif pour memory-worker-watchdog et
# memory-worker-auto-repair, qui lisent Result/ExecMainStatus. Depuis que index.py
# persiste son état dans le handler SIGTERM, une interruption n'est PAS un échec :
# le run suivant reprend là où il s'est arrêté.
SuccessExitStatus=SIGTERM

# Resource control (cgroup) — REX 2026-06-05: worker non-borné -> OOM global ->
# systemd-networkd affamé -> bail DHCP eth0 perdu -> tailscale ENETUNREACH -> SSH mort.
# Le worker est OOM-killed dans son cgroup AVANT d'affamer le stack réseau.
MemoryHigh={{ memory_worker_memory_high }}
MemoryMax={{ memory_worker_memory_max }}
MemorySwapMax={{ memory_worker_memory_swap_max }}
OOMScoreAdjust={{ memory_worker_oom_score_adjust }}

# Plafond CPU — incident 2026-07-28..31 (load 1.1 -> 44.9, %system 45 %, reclaim
# noyau, sessions Claude Code inutilisables). Nice=19 + IOSchedulingClass=idle
# ci-dessus ne bornent rien sous pression mémoire.
CPUQuota={{ memory_worker_cpu_quota }}

# NE PAS remettre RuntimeMaxSec= ici. man 5 systemd.service : « this setting does
# not have any effect on Type=oneshot services ». La valeur 7200 posée après
# l'incident du 2026-07-27 était donc INERTE — vérifié le 2026-07-31 : run de
# 13690 s (3h48) toujours actif au reboot, aucune intervention de systemd, et
# `systemctl --user show -p TimeoutStartUSec` renvoyait `infinity`.
# Le seul réglage qui borne un oneshot est TimeoutStartSec=, et il ne pourra
# être posé qu'une fois index.py rendu reprenable : aujourd'hui memory_state.json
# n'est écrit qu'après la boucle complète (index.py.j2:726), donc un SIGTERM en
# cours de run perd 100 % du travail effectué.

# No [Install] section: this is a timer-triggered Type=oneshot. Only the timer is
# enabled (systemctl --user enable …timer). Omitting [Install] prevents a stray
# `enable …service` from running the worker at every login.
