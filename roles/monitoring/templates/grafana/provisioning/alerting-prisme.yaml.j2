# {{ ansible_managed }}
apiVersion: 1

groups:
  - orgId: 1
    name: "Prisme — SLO"
    folder: "Prisme"
    interval: 1m
    rules:
{% for alert in [
  {
    'uid': 'prisme-stalled',
    'title': 'Prisme unavailable',
    'expr': 'absent(up{job="prisme"}) or up{job="prisme"} == 0',
    'threshold': 0,
    'severity': 'critical',
    'for': '3m'
  },
  {
    'uid': 'prisme-index-lag',
    'title': 'Prisme Qdrant projection lag',
    'expr': 'qdrant_projection_lag_seconds',
    'threshold': 300,
    'severity': 'critical',
    'for': '5m'
  },
  {
    'uid': 'prisme-projection-drift',
    'title': 'Prisme projection drift',
    'expr': 'increase(prisme_projection_drift_total[15m])',
    'threshold': 0,
    'severity': 'critical',
    'for': '5m',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-queue-stalled',
    'title': 'Prisme outbox queue stalled',
    'expr': 'prisme_queue_depth{queue="outbox"}',
    'threshold': 100,
    'severity': 'warning',
    'for': '10m'
  },
  {
    'uid': 'prisme-budget-low',
    'title': 'Prisme AI budget exhausted',
    'expr': 'prisme_budget_remaining_usd',
    'threshold': 0.01,
    'severity': 'warning',
    'for': '1m',
    'operator': 'lt',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-quality-low',
    'title': 'Prisme retrieval quality regression',
    'expr': 'prisme_retrieval_ndcg',
    'threshold': 0.75,
    'severity': 'warning',
    'for': '15m',
    'operator': 'lt',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-backup-stale',
    'title': 'Prisme backup stale',
    'expr': '(time() - prisme_backup_last_success_timestamp_seconds) and prisme_backup_last_success_timestamp_seconds > 0',
    'threshold': 93600,
    'severity': 'critical',
    'for': '5m'
  },
  {
    'uid': 'prisme-karakeep-circuit',
    'title': 'Prisme Karakeep circuit open',
    'expr': 'karakeep_connector_state{state="circuit_open"}',
    'threshold': 0,
    'severity': 'warning',
    'for': '5m'
  },
  {
    'uid': 'prisme-instagram-blocked',
    'title': 'Prisme Instagram connector blocked',
    'expr': 'increase(instagram_errors_total{reason="blocked"}[15m])',
    'threshold': 0,
    'severity': 'warning',
    'for': '5m',
    'noData': 'OK'
  },
  {
    'uid': 'prisme-instagram-auth-degraded',
    'title': 'Prisme Instagram connector auth degraded while active',
    'expr': 'instagram_connector_state{state="active"} == 1 and increase(instagram_errors_total{reason="auth"}[15m]) > 0',
    'threshold': 0,
    'severity': 'critical',
    'for': '5m',
    'noData': 'OK'
  }
] %}
      - uid: "{{ alert.uid }}"
        title: "{{ alert.title }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: VictoriaMetrics
            model:
              expr: '{{ alert.expr }}'
              intervalMs: 30000
              maxDataPoints: 43200
          - refId: B
            datasourceUid: __expr__
            model:
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: B
              conditions:
                - evaluator:
                    type: "{{ alert.operator | default('gt') }}"
                    params: [{{ alert.threshold }}]
        for: "{{ alert['for'] }}"
        # Séries contractuellement toujours présentes → Alerting sur trou (le silence
        # D3 ne doit pas revenir par la porte du NoData) ; séries omittables par design
        # (budget si LiteLLM down, ndcg si eval périmé, drift increase sans donnée) → OK.
        noDataState: "{{ alert.noData | default('Alerting') }}"
        execErrState: Error
        annotations:
          summary: "{{ alert.title }}"
          dashboard_uid: prisme-operations
        labels:
          severity: "{{ alert.severity }}"
          service: prisme
{% endfor %}
