# {{ ansible_managed }}
# Fichier lu par systemd (EnvironmentFile) AVANT que le service ne bascule sur
# {{ prisme_fetcher_user }} -> mode 0600 root:root est correct meme si le
# worker tourne sous un compte de service dedie.
#
# Jeton d'authentification vers le control-plane Prisme. Consomme par le
# worker (CANARY-1b) via os.environ["PRISME_FETCHER_TOKEN"] a l'usage --
# jamais rendu en dur dans prisme-fetcher.py.j2 (ce binaire est 0755
# root:root, lisible par tout utilisateur local ; ce fichier env, lui, reste
# 0600 root:root). Cf tasks/main.yml (assert vault_prisme_fetcher_token).
PRISME_FETCHER_TOKEN={{ vault_prisme_fetcher_token }}
