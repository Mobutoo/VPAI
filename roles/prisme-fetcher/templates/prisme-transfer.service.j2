# {{ ansible_managed }}
[Unit]
Description=Prisme fetcher -> banga transfer (rsync, oneshot, drained by timer)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ prisme_fetcher_user }}
Group={{ prisme_fetcher_group }}
# Meme raison que prisme-fetcher.service.j2 : ProtectHome=true masque
# /home /root /run/user et le compte de service n'a pas de home
# (create_home: false) -> ssh resout "~" (identity file, config) vers un
# repertoire inaccessible sans ce HOME explicite.
Environment=HOME={{ prisme_fetcher_root }}
ExecStart={{ prisme_fetcher_bin }}-transfer
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ prisme_fetcher_root }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
