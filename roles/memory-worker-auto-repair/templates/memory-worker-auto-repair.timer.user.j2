[Unit]
Description=Lance memory-worker-auto-repair periodiquement (reparation bornee, user)

[Timer]
OnBootSec={{ memory_worker_auto_repair_timer_on_boot_sec }}
OnUnitActiveSec={{ memory_worker_auto_repair_timer_on_unit_active_sec }}
Unit={{ memory_worker_auto_repair_service_name }}.service
Persistent=true

[Install]
WantedBy=timers.target
