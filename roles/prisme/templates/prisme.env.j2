# {{ ansible_managed }}
DATABASE_URL=postgresql://{{ prisme_database_user }}:{{ postgresql_password }}@{{ prisme_db_proxy_internal_ip }}:5432/{{ prisme_database_name }}
PRISME_SESSION_SECRET={{ vault_prisme_session_token }}
PRISME_OPERATOR_TOKEN={{ vault_prisme_operator_token }}
PRISME_METRICS_TOKEN={{ vault_prisme_metrics_token }}
# CANARY-1b/2 : jeton unique repo-wide qui authentifie le fetcher VPAI
# (roles/prisme-fetcher) sur les deux routes systeme
# (GET .../authorization, POST .../heartbeat) — cf dispatcher.ts
# verifyFetcherToken(). MEME secret que roles/prisme-fetcher (vault_prisme_fetcher_token,
# deja asserte >=32 caracteres par les deux roles).
PRISME_FETCHER_TOKEN={{ vault_prisme_fetcher_token }}
# Gate 5 (bouton d'activation Instagram) — HIGH re-revue CANARY-2 : sans ces
# deux variables explicitement cablees a false par defaut, le control-plane
# n'a aucun moyen de savoir que l'adapter/P5 sont reellement deployes et le
# gate reste rouge a perpetuite (ou pire, verrait un defaut implicite
# ambigu). Fail-closed par design (defaults roles/prisme/defaults/main.yml) :
# a ne jamais forcer a true tant que le deploiement reel (P5, molecule vert,
# controle de disponibilite) n'est pas confirme (CANARY-5).
PRISME_INSTAGRAM_ADAPTER_READY={{ prisme_instagram_adapter_ready | default(false) | bool | lower }}
PRISME_INSTAGRAM_P5_DEPLOYED={{ prisme_instagram_p5_deployed | default(false) | bool | lower }}
PRISME_FIXTURE_MODE=false
PRISME_KARAKEEP_ENABLED={{ prisme_karakeep_enabled | bool | lower }}
PRISME_KARAKEEP_BASE_URL={{ prisme_karakeep_base_url }}
PRISME_KARAKEEP_TOKEN={{ vault_prisme_karakeep_token | default('') }}
PRISME_WEBHOOK_TOKEN={{ vault_prisme_karakeep_token | default('') }}
QDRANT_URL=http://{{ project_name }}_qdrant:6333
QDRANT_API_KEY={{ prisme_qdrant_api_key }}
# Chemin de lecture (C1 revue 2026-08-01) : le web appelle le sidecar sparse sur le réseau
# compose interne — DNS = nom de service (pas de préfixe projet pour un service du même compose).
PRISME_EMBEDDING_URL=http://sparse-query:8080
PRISME_EMBEDDING_TOKEN={{ vault_prisme_embedding_token }}
PRISME_FUSION_MODE={{ prisme_fusion_mode }}
{% if prisme_dense_embedding_url | length > 0 %}
PRISME_DENSE_EMBEDDING_URL={{ prisme_dense_embedding_url }}
{% endif %}
LITELLM_URL=http://{{ project_name }}_litellm:4000
LITELLM_API_KEY={{ prisme_litellm_key }}
# Modèle de synthèse /ask (P3). Arbitrage G3 2026-08-01 : claude-haiku (suivi
# d'instructions strict pour citations+abstention, éco ; cap 0,50 $/j borne le risque).
PRISME_ASK_MODEL={{ prisme_ask_model }}
# Budget /jour pour le fallback de prisme_budget_remaining_usd (P4) quand LiteLLM
# /key/info est injoignable. Doit refléter le cap de la clé prisme-production.
PRISME_LITELLM_DAILY_BUDGET={{ prisme_litellm_daily_budget }}
