# ================================================================
# ROUTER SETTINGS — Intelligent routing
# ================================================================
router_settings:
  routing_strategy: "{{ litellm_routing_strategy }}"
  enable_tag_filtering: {{ litellm_enable_tag_filtering | lower }}
  # Cooldown a model for 60s after failure before retrying
  cooldown_time: 60
  # Number of retries across different deployments
  num_retries: {{ litellm_num_retries }}
  # Timeout per request
  timeout: {{ litellm_request_timeout }}
  disable_cooldowns: false

# ================================================================
# LITELLM SETTINGS — Cache, fallbacks, callbacks
# ================================================================
litellm_settings:
  drop_params: true
  set_verbose: false
  num_retries: {{ litellm_num_retries }}
  request_timeout: {{ litellm_request_timeout }}

  # Garde-fou finding CRITIQUE (c), gate technique Optimus B4 2026-08-12
  # (docs/ops/gates-journal.md ligne 2026-08-12 après-midi) : un client peut
  # ECRASER le pin fournisseur/ZDR serveur (extra_body.provider ci-dessus)
  # en renvoyant son propre extra_body.provider — merge shallow LiteLLM,
  # AUCUN réglage natif (allowed_openai_params, drop_params) ne filtre un
  # sous-champ arbitraire d'extra_body. Callback custom async_pre_call_hook
  # (seul mécanisme natif exploitable, vérifié sur litellm==1.83.3 pinné —
  # cf. commentaire d'en-tête du fichier) : strip provider (top-level +
  # extra_body) côté client AVANT le merge Router. Fichier monté à
  # /app/guard_extra_body.py, MÊME répertoire que /app/config.yaml (requis
  # par get_instance_fn qui résout le module relatif au config_file_path).
  callbacks:
    - guard_extra_body.proxy_handler_instance

  # Fallback chains: primary -> fallback1 -> fallback2
  # Strategy: open-source/free fallbacks first, paid providers as last resort
  # REX 2026-03-17: claude-haiku n'avait PAS de fallback → dead-end quand credits Anthropic $0.
  #   deepseek-v3-free tombait en fallback vers claude-haiku (mort aussi) → boucle morte.
  #   Fix: JAMAIS de modèle payant comme fallback terminal. Free models = filet de sécurité ultime.
  fallbacks:
    - claude-opus: ["claude-sonnet", "gpt-codex"]
{% if openrouter_api_key | default('') | length > 0 %}
    - claude-sonnet: ["gpt-4o", "glm-5"]
    - claude-haiku: ["qwen3-coder", "deepseek-v3-free"]
    - kimi-k2: ["glm-5", "deepseek-v3-free"]
    - deepseek-r1: ["deepseek-r1-free", "qwen3-coder"]
    - deepseek-v3: ["deepseek-v3-free", "qwen3-coder"]
    - glm-5: ["deepseek-v3-free", "qwen3-coder"]
    - grok-search: ["deepseek-v3-free", "qwen3-coder"]
    # Vision : pas de free vision fiable — secours interne au trio (voir bloc VISION)
    - gemini-flash-or: ["qwen3-vl"]
    - qwen3-vl: ["gemini-flash-or"]
    - gpt-4o-or: ["gemini-flash-or", "qwen3-vl"]
    - qwen3-coder: ["deepseek-v3-free", "glm-5"]
    - deepseek-v3-free: ["qwen3-coder", "glm-5"]
    - deepseek-r1-free: ["qwen3-coder", "deepseek-v3-free"]
    # Banga (self-hosted) : jamais claude-sonnet en terminal (REX 2026-03-17 ci-dessus,
    # meme lecon appliquee ici) — le fallback reste sur du gratuit avant le cloud paye.
    - banga-coder: ["banga-coder-longctx", "banga-general", "qwen3-coder", "deepseek-v3-free"]
    - banga-coder-longctx: ["banga-general", "qwen3-coder"]
    - banga-general: ["deepseek-v3-free", "qwen3-coder"]
{% else %}
    - claude-sonnet: ["gpt-4o"]
    - claude-haiku: ["gpt-4o-mini"]
    - banga-coder: ["banga-coder-longctx", "banga-general", "claude-haiku"]
    - banga-coder-longctx: ["banga-general", "claude-haiku"]
    - banga-general: ["claude-haiku"]
{% endif %}
    - gpt-4o: ["claude-sonnet", "glm-5"]
    - gpt-4o-mini: ["qwen3-coder", "deepseek-v3-free"]
    - gpt-codex: ["claude-sonnet", "glm-5"]
{% if google_gemini_api_key | default('') | length > 0 or openrouter_mop_api_key | default('') | length > 0 %}
    - mop-ingest: ["deepseek-v3-free", "qwen3-coder"]
{% endif %}

  # Prometheus metrics
  success_callback: ["prometheus"]
  failure_callback: ["prometheus"]

  # Semantic cache: Redis exact match + Qdrant similarity search
  cache: true
  cache_params:
    type: "{{ litellm_cache_type }}"
    # Redis for exact match
    host: "os.environ/REDIS_HOST"
    port: "os.environ/REDIS_PORT"
    password: "os.environ/REDIS_PASSWORD"
    ttl: {{ litellm_cache_ttl }}
    # Qdrant for semantic similarity
    similarity_threshold: {{ litellm_cache_similarity_threshold }}
    qdrant_semantic_cache_embedding_model: "{{ qdrant_embedding_model }}"
    qdrant_collection_name: "{{ qdrant_cache_collection }}"
    qdrant_api_base: "http://qdrant:6333"
    qdrant_api_key: "os.environ/QDRANT_API_KEY"

  # Provider budget caps (USD per day)
  provider_budget_config:
    anthropic:
      budget_limit: {{ litellm_anthropic_budget_daily }}
      time_period: "1d"
    openai:
      budget_limit: {{ litellm_openai_budget_daily }}
      time_period: "1d"
{% if openrouter_api_key | default('') | length > 0 %}
    openrouter:
      budget_limit: {{ litellm_openrouter_budget_daily }}
      time_period: "1d"
{% endif %}
{% if google_gemini_api_key | default('') | length > 0 %}
    gemini:
      budget_limit: {{ litellm_google_budget_daily }}
      time_period: "1d"
{% endif %}
{% if byteplus_api_key | default('') | length > 0 %}
    # BytePlus — Seedance vidéo uniquement (ponctuel, budget mensuel séparé)
    # NON inclus dans le budget global journalier de $5
    bytedance:
      budget_limit: {{ litellm_byteplus_budget_monthly }}
      time_period: "30d"
{% endif %}

# ================================================================
# GENERAL SETTINGS — Auth, database, budget global
# ================================================================
general_settings:
  master_key: "os.environ/LITELLM_MASTER_KEY"
  database_url: "os.environ/DATABASE_URL"
  # Budget global cross-providers (hard cap absolu, toutes sources confondues)
  # Géré au niveau LiteLLM — bloque les appels si dépassé (retourne 429)
  # Les alertes 70%/90% sont gérées par n8n (cron 1h → PostgreSQL → Telegram)
  max_budget: {{ litellm_budget_global_daily }}
  budget_duration: "1d"
  # REX: health_check_interval=0 NE désactive PAS les health checks — LiteLLM
  # l'interprète comme "interval de 0s" = check permanent (~2500 appels/jour/modèle).
  # Coût constaté : $10.66/semaine en health checks parasites (mars 2026).
  # Solution : supprimer health_check_interval + background_health_checks: false.
  # ATTENTION : le Docker healthcheck doit utiliser /health/readiness (pas /health)
  # car /health fait de vrais appels LLM à chaque modèle à chaque invocation.
  # Pannes détectées via fallbacks et métriques Prometheus.
  background_health_checks: false
  # Credit error alerting — webhook → n8n → Telegram (monitoring bot)
  # alert_types limite au strict nécessaire : llm_exceptions (402/RateLimit) + budget_alerts
  # Le workflow n8n filtre en plus les patterns crédit avant d'envoyer (double filtre).
  alerting: ["webhook"]
  alerting_webhook_url: "http://n8n:5678/webhook/litellm-credit-alert"
  alert_types:
    - "llm_exceptions"
    - "budget_alerts"
