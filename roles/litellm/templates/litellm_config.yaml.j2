  # Consommateur : gap-analysis cf-api (CF_GAP_MODEL=qwen-cf). Scale-to-zero : cold ~157 s
  # → timeout per-model large ; coût = temps GPU (4090 $0.34/h), pas les tokens.
  - model_name: "qwen-cf"
    litellm_params:
      model: "openai/Qwen/Qwen2.5-14B-Instruct-AWQ"
      api_base: "https://api.runpod.ai/v2/{{ litellm_qwen_cf_endpoint_id }}/openai/v1"
