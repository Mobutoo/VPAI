from pathlib import Path
import os

from huggingface_hub import snapshot_download

snapshot = Path(snapshot_download(
    repo_id="{{ prisme_sparse_model }}",
    revision="{{ prisme_sparse_revision }}",
    cache_dir="/cache",
    token=os.environ["HF_TOKEN"].strip(),
))
if not snapshot.is_dir() or not (snapshot / "config.json").is_file():
    raise RuntimeError("pinned sparse model snapshot is incomplete")
print("READY {{ prisme_sparse_model }}@{{ prisme_sparse_revision }}")
