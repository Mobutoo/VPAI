  # ============================================================
  # TIER ECO — Échelle d'escalade de modèles B4 (implement OpenHands)
  # Alias DÉDIÉS eco-1/eco-2, SANS fallback (attestation modèle forte,
  # même discipline que claude-sonnet-cached). Conformité politique de
  # données : docs/specs/2026-08-11-b4-gate-politique-donnees-tenants.md
  # (option B RATIFIÉE) — provider.data_collection=deny + provider.zdr=true
  # + allow_fallbacks=false + provider.order verrouillé à UN fournisseur
  # (échec explicite si ce fournisseur n'est plus ZDR au moment de la
  # requête, plutôt que fallback silencieux — garde-fou anti-dérive).
  # Couples (model_id, provider_name) vérifiés membres de
  # GET /api/v1/endpoints/zdr le 2026-08-11 (source autoritaire ; commande
  # de re-vérification rejouable : optimus docs/research/2026-08-11-b4-
  # shortlist-candidats-eco.md §6 point 4).
  # Prix relevés 2026-08-11 (openrouter.ai/api/v1/endpoints/zdr).
  # ============================================================
  - model_name: "eco-1"
    litellm_params:
      # DeepSeek V4 Flash 0731 — candidat le moins cher, cache prompt
      # confirmé (input_cache_read $0.016/M chez DeepInfra).
      model: "openrouter/deepseek/deepseek-v4-flash-0731"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["deepinfra"]
    model_info:
      max_input_tokens: 1048576
      max_output_tokens: 8192
      input_cost_per_token: 0.00000008
      output_cost_per_token: 0.00000018
      cache_read_input_token_cost: 0.000000016
      metadata:
        tier: "eco"
        tags: ["code", "optimus-factory", "eco-1", "prompt-caching", "zdr"]

  - model_name: "eco-2"
    litellm_params:
      # Qwen3 Coder Next — spécialisé code agentique, cache prompt
      # confirmé (input_cache_read $0.07/M chez Parasail).
      model: "openrouter/qwen/qwen3-coder-next"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["parasail"]
    model_info:
      max_input_tokens: 262144
      max_output_tokens: 8192
      input_cost_per_token: 0.00000012
      output_cost_per_token: 0.0000008
      cache_read_input_token_cost: 0.00000007
      metadata:
        tier: "eco"
        tags: ["code", "optimus-factory", "eco-2", "prompt-caching", "zdr"]

  # ============================================================
  # TIER CAMPAGNE 3 — B4 candidats rangs hauts (sonnet-class / fable-class)
  # docs/research/2026-08-12-b4-candidats-rangs-hauts.md (gate ratifié
  # docs/ops/gates-journal.md 2026-08-12 midi). Même discipline fail-closed
  # qu'eco-1/eco-2 : data_collection=deny + zdr=true + allow_fallbacks=false
  # + provider.order verrouillé à UN fournisseur, AUCUNE entrée dans la map
  # `fallbacks:` (attestation modèle forte). Couples (model_id,
  # provider_name) vérifiés membres de GET /api/v1/endpoints/zdr le
  # 2026-08-12 (722 endpoints). Prix relevés live à la même date.
  # ============================================================
  - model_name: "glm-52"
    litellm_params:
      # GLM-5.2 — rang 3 "sonnet-class" recommandé (SWE-bench Pro 62,1 % à
      # 1,1 pt de Sonnet-5, ~3,5x moins cher). Endpoint DigitalOcean :
      # tools confirmé présent (supported_parameters).
      model: "openrouter/z-ai/glm-5.2"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["digitalocean"]
    model_info:
      max_input_tokens: 262144
      max_output_tokens: 8192
      input_cost_per_token: 0.00000063
      output_cost_per_token: 0.00000198
      cache_read_input_token_cost: 0.0000000945
      metadata:
        tier: "campagne3"
        tags: ["code", "optimus-factory", "rang3", "prompt-caching", "zdr"]

  - model_name: "deepseek-v4-pro"
    litellm_params:
      # DeepSeek V4 Pro — repositionné rang 3 (H2 : écart ~24 pts SWE-bench
      # Pro sous Opus 5, PAS un candidat rang 4). Endpoint Novita : tools
      # confirmé présent. JAMAIS DeepInfra comme fallback silencieux —
      # provider.order verrouillé exclut ce choix par construction.
      model: "openrouter/deepseek/deepseek-v4-pro"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["novita"]
    model_info:
      max_input_tokens: 1048576
      max_output_tokens: 8192
      input_cost_per_token: 0.000001168
      output_cost_per_token: 0.000002336
      cache_read_input_token_cost: 0.00000009855
      metadata:
        tier: "campagne3"
        tags: ["code", "optimus-factory", "rang3", "prompt-caching", "zdr"]

  - model_name: "kimi-k3"
    litellm_params:
      # Kimi K3 — seul candidat ZDR viable au rang 5 "fable-class" (Fable 5
      # lui-même non routable ZDR, 0/722 endpoints). Endpoint DigitalOcean
      # choisi car tools confirmé présent — DeepInfra EXCLU explicitement :
      # seul provider ZDR de K3 SANS tools (piège identifié au dossier,
      # provider.order verrouillé l'exclut par construction).
      model: "openrouter/moonshotai/kimi-k3"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["digitalocean"]
    model_info:
      max_input_tokens: 1048576
      max_output_tokens: 8192
      input_cost_per_token: 0.00000285
      output_cost_per_token: 0.00001425
      cache_read_input_token_cost: 0.000000285
      metadata:
        tier: "campagne3"
        tags: ["code", "optimus-factory", "rang5", "prompt-caching", "zdr"]

  - model_name: "claude-sonnet-5-zdr"
    litellm_params:
      # Bras de contrôle OBLIGATOIRE de la campagne 3 (référent réel du
      # rang 3, seul rang où des candidats hors-Anthropic concourent).
      # DISTINCT de "claude-sonnet-5-cached" (alias de migration sûre de
      # l'orchestrateur, même modèle/pin) : deux consommateurs différents
      # gardés découplés à dessein (benchmark vs prod smoke), redite
      # documentée — fusion possible en fil de l'eau si jugée utile.
      # Pinné ZDR google-vertex (slug exact — PAS "google", cf. finding de
      # revue re-vérifié GET /api/v1/providers 2026-08-12).
      model: "openrouter/anthropic/claude-sonnet-5"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["google-vertex"]
    model_info:
      max_input_tokens: 1000000
      max_output_tokens: 8192
      input_cost_per_token: 0.000002
      output_cost_per_token: 0.00001
      cache_read_input_token_cost: 0.0000002
      metadata:
        tier: "campagne3"
        tags: ["code", "optimus-factory", "rang3-controle", "prompt-caching", "zdr"]

  - model_name: "gpt-56-sol"
    litellm_params:
      # GPT-5.6 Sol — candidat rang 4 "opus-class" (amendement opérateur
      # 2026-08-12, hors périmètre initial de la campagne 3 ratifiée :
      # Terminal-Bench 2.1 88,8-89,5 %, prix quasi identique à Opus 5, pas
      # d'avantage coût net — docs/research/2026-08-12-b4-candidats-rangs-
      # hauts.md §3 rang 4). DEUX endpoints Azure ZDR existent (tag "azure"
      # base/us et tag "azure/eu", même provider_name "Azure") — slug
      # provider commun re-vérifié GET /api/v1/providers 2026-08-12 :
      # {"slug": "azure", "name": "Azure"} (entrée UNIQUE, pas de slug
      # séparé par région, même situation que google-vertex). order:
      # ["azure"] ne distingue donc PAS la région ; endpoint "azure" (base)
      # retenu pour le model_info (moins cher, cf. table prix) mais le
      # routage réel peut atterrir sur "azure/eu" (~+10% prix) — même
      # résidu de précision que documenté pour google-vertex.
      model: "openrouter/openai/gpt-5.6-sol"
      api_key: "os.environ/OPENROUTER_API_KEY"
      max_tokens: 8192
      cache_control_injection_points:
        - location: message
          role: system
      extra_body:
        provider:
          data_collection: "deny"
          zdr: true
          allow_fallbacks: false
          order: ["azure"]
    model_info:
      max_input_tokens: 1050000
      max_output_tokens: 8192
      input_cost_per_token: 0.000005
      output_cost_per_token: 0.00003
      cache_read_input_token_cost: 0.0000005
      metadata:
        tier: "campagne3"
        tags: ["code", "optimus-factory", "rang4", "prompt-caching", "zdr"]
{% endif %}

  # ============================================================
  # TIER FREE — Variantes :free OpenRouter (pas de credits requis)
  # ============================================================
{% if openrouter_api_key | default('') | length > 0 %}
  # Qwen3 Coder FREE — Tâches triviales, code, formatage
  - model_name: "qwen3-coder"
