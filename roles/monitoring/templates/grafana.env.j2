# {{ ansible_managed }}
# Grafana environment — credentials managed via env_file (not inline in compose)
GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_SERVER_ROOT_URL=https://{{ caddy_grafana_domain }}/
{% if grafana_plugins_preinstall_sync is defined and grafana_plugins_preinstall_sync %}
GF_PLUGINS_PREINSTALL_SYNC={{ grafana_plugins_preinstall_sync }}
{% endif %}
